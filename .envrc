_local_bin="$HOME/.local/bin"
PATH_add "$_local_bin"

# Load the default devShell when Nix is available.
if command -v nix > /dev/null 2>&1; then
  use flake
fi

if ! command -v task > /dev/null 2>&1 && ! [[ -x "$_local_bin/task" ]]; then
  log_status "go-task is missing; run: bash ./install.sh --tools-only"
fi
