# Files managed by home-manager — chezmoi should not touch these.
# Add patterns here for anything nix manages declaratively.
.nix-profile
.nix-defexpr
.nix-channels
result
{{ if not (stat (joinPath .chezmoi.homeDir "Development/cmcs/mdp-application")) -}}
# Work-repo agent directives (encrypted source) deploy only where the checkout
# already exists — never create the Development tree on other hosts.
Development
Development/**
{{ end -}}
{{ if ne .chezmoi.os "darwin" -}}
.local/bin/toggle-browser
{{ end -}}
{{ if not (stat (joinPath .chezmoi.homeDir ".config/keepassxc/keepassxc.ini")) -}}
# The KeePassXC theme is asserted by a modify_ script that edits the app's own
# ini in place — deploy it only where that ini already exists, never create a
# KeePassXC config on a host without KeePassXC.
.config/keepassxc/keepassxc.ini
{{ end -}}
{{ if ne .chezmoi.os "windows" -}}
# Agent instructions managed by home-manager on Linux/macOS; chezmoi owns them on Windows only.
.claude/CLAUDE.md
.config/claude/CLAUDE.md
.config/claude/log-bash.sh
.config/github-copilot/copilot-defaults.instructions.md
.config/github-copilot/intellij/global-copilot-instructions.md
.config/Code/User/prompts/copilot-defaults.instructions.md
# Terminal config read by home-manager (darwin appends theme colors); chezmoi source is the base only.
.config/kitty/kitty.conf
{{ end -}}
{{ if ne .chezmoi.os "linux" -}}
# CDEmu mounts disc images on a virtual SCSI optical drive provided by the vhba
# kernel module, so the helper is Linux-only. macOS mounts bin/cue natively via
# hdiutil and Windows has its own virtual-drive support; neither needs this.
.local/bin/cdemu-mount
# steam-add-game writes Steam's shortcuts.vdf and CompatToolMapping, which only
# the Linux client keeps at these paths.
.local/bin/steam-add-game
{{ end -}}
{{ if not (lookPath "dolphin") -}}
# The CDEmu service menu is a KIO context-menu provider and does nothing
# without Dolphin to read it — deploy it only where Dolphin is installed,
# rather than creating a stray ~/.local/share/kio on every host.
.local/share/kio
.local/share/kio/**
{{ end -}}
