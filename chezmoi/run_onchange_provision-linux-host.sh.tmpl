#!/usr/bin/env bash
#
# Provision the host-level bits that nix cannot own on non-NixOS Linux boxes:
# distro packages that must match the running desktop's ABI, the firewall, and
# Wake-on-LAN.
#
# Why packages live here at all: a few are Qt/KF6 *plugins* dlopen'd by the
# distro's own Plasma binaries. Those cannot come from nixpkgs — nixpkgs and the
# distro ship different KF6 minor versions, and loading a nixpkgs plugin into a
# distro process would mix two KF6 ABIs in one address space. Nix stays
# authoritative for everything that runs as its own process; this covers only
# the in-process-plugin exception.
#
# Firewall policy: ufw is installed if missing and made the *only* firewall, so
# every non-NixOS Linux host converges on one rule surface. The NixOS hosts use
# networking.firewall instead and are skipped outright.
#
# Service ports stay closed. Anything remote is reached by forwarding over ssh
# (ssh -N -L <port>:localhost:<port> <host>), so ssh key auth is the single
# front door rather than each service's own secret. 22 is the only open port.
#
# sshd is installed, hardened and started here, and the dedicated remoting key
# is authorized for it. That key's private half is sops-encrypted in the repo
# and materialized to ~/.ssh/id_remoting by home-manager/modules/sops.nix; the
# NixOS hosts authorize the same public key via modules/services/sshd.nix.
#
# run_onchange_ (not run_once_) is keyed on this script's rendered hash, so
# editing the tables below re-runs it, and a fresh install re-runs it too
# because chezmoi's state DB starts empty. It does NOT notice a package removed
# by hand afterwards — reinstall it, or touch this file to force a re-check.
#
# Everything here is idempotent and must stay a silent no-op — in particular it
# must not prompt for sudo — on a host that is already provisioned.

{{ if ne .chezmoi.os "linux" -}}
exit 0
{{ end -}}

set -euo pipefail

readonly TAG=provision-linux-host

# The account this repo's home-manager config is written for. home.username and
# home.homeDirectory in home-manager/home.nix are mkDefault "jhettenh" and
# "/home/jhettenh", and homeConfigurations is keyed "jhettenh@linux" — so on a
# host whose login account is something else (graha logs in as "ansible"),
# `task home-switch` has no matching user to activate into. Section 2 creates
# it so the standard workflow works after `su - jhettenh`.
readonly REPO_USER=jhettenh

# Packages every Linux host gets, by generic name — pkg_name() maps them onto
# what each distro actually calls them. Keep the justification attached to each:
# anything that *could* come from nixpkgs belongs in home-manager/common.nix.
PACKAGES=(
  # sshd. Not an ABI case — it is here because the *daemon* has to be the
  # distro's, wired to the distro's PAM stack and systemd units. The nixpkgs
  # openssh in the user profile is only an ssh client.
  sshd

  # The firewall this policy is built on.
  ufw

  # kitty is gated out of the Nix package set on generic Linux (see
  # profiles/desktop-linux.nix nixosOnlyPackages) because it links against
  # Nix's own glibc and cannot safely load a host GL driver. It still needs to
  # exist on every host, though — home-manager wires a KDE global shortcut and
  # the default-terminal association straight to kitty.desktop, and both come
  # up blank if that .desktop file is missing. Installing it here (rather than
  # leaving it a manual `pkg-install kitty` step) is what actually guarantees
  # that.
  kitty

  # ksshaskpass — the graphical sudo/ssh password dialog find_askpass() prefers.
  #
  # This is what makes the no-TTY path above work rather than warn. `task
  # switch` runs chezmoi as a subprocess, and anything driving it from an
  # editor, an agent or a desktop launcher has no controlling terminal either,
  # so without an askpass helper every such run reaches the packages it must
  # install and quits on a warning. That is exactly the failure that left this
  # host unprovisioned.
  #
  # Chicken-and-egg, and unavoidable: installing it needs the sudo it exists to
  # supply, so the FIRST run on a new host still has to come from an
  # interactive shell. Every run after that gets the dialog.
  #
  # In PACKAGES rather than PLASMA_PACKAGES by request, so every Linux host has
  # it. On an apt host with no Plasma that pulls in a slice of KF6 for one
  # dialog — if that ever matters more than the convenience, move this one line
  # down into PLASMA_PACKAGES. Named identically on pacman, apt and dnf, and
  # installs to /usr/bin/ksshaskpass on all three, which is find_askpass()'s
  # first candidate.
  ksshaskpass
)

# Plasma-only additions, appended below when a Plasma session is actually
# installed. KRdp drives KWin's fake-input and screencast Wayland protocols, so
# it is useless — and on apt hosts would drag in a pile of KDE — anywhere else.
# Mint/Cinnamon and other non-Plasma desktops must not get this.
#
# The detection is done HERE, at template-render time, and baked into the line
# below — not only at runtime. run_onchange_ fires on a change to this script's
# rendered hash, so a purely runtime check would latch: a host with no Plasma
# when this first ran would skip krdp, the hash would never change, and krdp
# would never be installed even after a desktop was added. Rendering the answer
# in means installing Plasma flips this line, which changes the hash, which
# re-runs the script. The runtime check below still gates the actual install, so
# a stale render can only cost a redundant re-run, never a wrong install.
PLASMA_PRESENT={{ if or (lookPath "plasmashell") (lookPath "kwin_wayland") }}yes{{ else }}no{{ end }}

PLASMA_PACKAGES=(
  # KRdp — Plasma's RDP server for Wayland sessions. Its System Settings panel
  # (kcm_krdpserver.so) is loaded into the distro's systemsettings process, so
  # it has to match the distro's KF6. The NixOS host gets this from
  # modules/desktop/krdp.nix instead.
  krdp
)

# The remoting keypair's public half, inlined at render time from
# chezmoi/dot_config/ssh/remoting-key.pub. Inlined rather than read from the
# deployed copy for two reasons: no dependency on .config having been applied
# first, and rotating the key changes this script's hash, which is what makes
# run_onchange_ re-authorize it.
#
# restrict drops everything (agent, X11, user-rc, tunnels), then port-forwarding
# and pty are added back: exactly a shell plus the -L forward KRdp needs, which
# is the whole remit of this key.
readonly REMOTING_KEY='restrict,port-forwarding,pty {{ trim (include "dot_config/ssh/remoting-key.pub") }}'

# Extra TCP ports to open, mirroring the networking.firewall.allowedTCPPorts
# entries the NixOS hosts get from their modules. Format: "<port> <comment>".
#
# Deliberately empty. Service ports are reached by forwarding over ssh rather
# than by opening them to the LAN:
#
#   ssh -N -L 3389:localhost:3389 <host>    # KRdp
#
# That puts each service behind ssh host-key verification and key auth instead
# of whatever single secret the service itself carries — for KRdp that would be
# one username/password in KWallet guarding a full desktop-takeover channel.
# krdpserver binds 0.0.0.0 with no way to narrow it, so the closed port is the
# only thing keeping it off the network.
#
# Port 22 is handled separately below; it is the access path, not an exception.
FIREWALL_TCP=()

# Firewalls that must not run alongside ufw. Only units that actually exist on
# the host are touched.
CONFLICTING_FIREWALLS=(firewalld nftables iptables ip6tables)

# Hosts reached over WIFI rather than ethernet, by hostname.
#
# Opt-in per host, and deliberately not derived from "is a laptop": tifa, cloud
# and aerith all report a chassis with a battery, so that test would sweep in
# the cloud kiosk — a wall panel whose entire job is to stay awake — and put it
# to sleep. Only aerith actually needs this: it has no wired NIC at all, so
# neither the wake path in section 7 nor a wired link is available to it.
#
# Membership carries THREE changes:
#
#   * WoWLAN is armed on the wifi connection.
#   * The power button suspends instead of shutting down, on AC.
#   * Wifi power-save is turned off.
#
# The first two are inseparable: WoWLAN works only from suspend, where the card
# stays powered and associated to the AP; from a full power-off it is dead and
# associated to nothing. A host that reaches "off" can never use the wake path
# it was just given.
#
# The third is about interactive latency, and it is the difference between a
# usable remote desktop and an unusable one. Measured on aerith with power-save
# on, on an otherwise excellent link (5 GHz, -42 dBm, 1.9 Gb/s negotiated,
# 313 Mbit/s of real throughput through the ssh tunnel):
#
#     idle:      min 1.9ms   avg 53-60ms   jitter 30-43ms
#     saturated: min 3.1ms   avg 25.6ms
#
# Average latency HALVING under saturation is the tell — load normally raises
# it. The radio is parking between beacons and only draining the queue when
# traffic forces it awake, so every keystroke and mouse move in an RDP session
# waits on a beacon. Bandwidth was never the problem; the 28x gap between the
# 1.9ms floor and the 53ms average was.
#
# The cost is battery, which is why this is scoped to hosts that are remoted
# into and expected to sit on AC rather than applied to every laptop.
WIFI_REMOTE_HOSTS=(aerith)

note() { printf '%s: %s\n' "$TAG" "$*"; }
warn() { printf '%s: WARNING: %s\n' "$TAG" "$*" >&2; }

# --- python shadowing policy ------------------------------------------------

# nixpkgs' python3, once it is in the profile, owns `python3` on $PATH ahead of
# /usr/bin and so becomes the interpreter behind every `#!/usr/bin/env python3`
# on the host — distro scripts included, whose modules live in the distro
# python's site-packages and are unreachable from the nix one. That is what
# broke the CDEmu client: it died on `import gi` before reaching its daemon.
#
# Shadowing only buys anything while the nix interpreter is genuinely newer, so
# home-manager keeps it out of the profile on hosts where the distro is level or
# ahead — see preferSystemPython in home-manager/common.nix. That flag is chosen
# during flake evaluation, which cannot see what the distro ships; this is the
# check that notices once it has gone stale. It runs ahead of the NixOS and WSL
# exits below because those hosts drift the same way.
nix_py=$HOME/.nix-profile/bin/python3
if [ -x "$nix_py" ] && [ -x /usr/bin/python3 ]; then
  py_ver() { "$1" -c 'import sys; print("%d.%d.%d" % sys.version_info[:3])' 2>/dev/null; }
  nix_ver=$(py_ver "$nix_py") || true
  sys_ver=$(py_ver /usr/bin/python3) || true

  # sort -V puts the lower version first, so the nix one sorting first means the
  # distro is ahead; equal versions sort to the same string and land here too,
  # which is right — a tie still leaves every distro module on the distro side.
  if [ -n "$nix_ver" ] && [ -n "$sys_ver" ] &&
    [ "$(printf '%s\n%s\n' "$nix_ver" "$sys_ver" | sort -V | head -1)" = "$nix_ver" ]; then
    warn "nixpkgs python $nix_ver is shadowing the distro's $sys_ver on \$PATH."
    warn "Set _module.args.preferSystemPython = true for this host, so distro"
    warn "scripts with an 'env python3' shebang resolve their own modules."
  else
    note "unchanged  python shadowing (nix $nix_ver newer than distro $sys_ver)"
  fi
fi

# --- applicability ----------------------------------------------------------

if [ -e /etc/NIXOS ]; then
  note "skipped    NixOS host — nix owns packages and networking.firewall"
  exit 0
fi

# WSL has no host firewall worth configuring: traffic is NATed by the Windows
# host, systemd may not be managing the network at all, and a default-deny ufw
# would only break Windows<->WSL loopback forwarding. Packages are still
# skipped here too — no WSL host in this repo runs a Plasma session.
if [ -n "${WSL_DISTRO_NAME:-}" ] || grep -qi microsoft /proc/sys/kernel/osrelease 2>/dev/null; then
  note "skipped    WSL — no host firewall, no desktop session"
  exit 0
fi

if [ "${PROVISION_HOST_SKIP:-0}" = "1" ]; then
  note "PROVISION_HOST_SKIP=1 set — skipping"
  exit 0
fi

# --- package manager --------------------------------------------------------

if command -v pacman >/dev/null 2>&1; then
  PM=pacman
elif command -v apt-get >/dev/null 2>&1; then
  PM=apt
elif command -v dnf >/dev/null 2>&1; then
  PM=dnf
else
  warn "no supported package manager (pacman/apt/dnf) — cannot provision"
  exit 0
fi

# Generic name -> distro package name. Arch calls the ssh daemon's package
# "openssh" and ships client and server together; Debian and Fedora split them
# and only "openssh-server" carries sshd.
pkg_name() {
  case "$1" in
  sshd)
    case "$PM" in
    pacman) echo openssh ;;
    *) echo openssh-server ;;
    esac
    ;;
  vhba)
    # The vhba kernel module must be built against the running kernel, so every
    # distro ships it as a source/DKMS package under its own name.
    #
    # Arch's prebuilt "vhba-module" is deliberately NOT used: it Depends On the
    # stock `linux` package, so on a CachyOS, Zen or LTS kernel it would both
    # drag in a kernel the host does not boot and install a module compiled for
    # that other kernel, which will not load into the running one.
    case "$PM" in
    pacman) echo vhba-module-dkms ;;
    apt) echo vhba-dkms ;;
    dnf) echo akmod-vhba ;;
    esac
    ;;
  *) echo "$1" ;;
  esac
}

pkg_installed() {
  local p
  p=$(pkg_name "$1")
  case "$PM" in
  pacman) pacman -Qq "$p" >/dev/null 2>&1 ;;
  apt) dpkg-query -W -f='${Status}' "$p" 2>/dev/null | grep -q "ok installed" ;;
  dnf) rpm -q "$p" >/dev/null 2>&1 ;;
  esac
}

pkg_install() {
  local mapped=()
  for g in "$@"; do mapped+=("$(pkg_name "$g")"); done

  case "$PM" in
  # --noconfirm / -y because this runs inside `task switch`, where an
  # interactive package prompt would stall the whole activation.
  pacman) $SUDO pacman -S --needed --noconfirm "${mapped[@]}" ;;
  apt) DEBIAN_FRONTEND=noninteractive $SUDO apt-get install -y "${mapped[@]}" ;;
  dnf) $SUDO dnf install -y "${mapped[@]}" ;;
  esac
}

# --- root -------------------------------------------------------------------
#
# Resolved lazily, on first mutation only, so an already-provisioned host never
# prompts. Mirrors run_once_provision-tifa-etc.sh.tmpl; see the longer rationale
# there.

SUDO=""
sudo_ready=0
sudo_failed=0

# Echo a usable askpass helper, or fail. Only a graphical session qualifies:
# these helpers all open a window, so without a display they would either fail
# outright or hang a headless run waiting on a dialog nobody can see.
find_askpass() {
  if [ -z "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]; then
    return 1
  fi

  # An explicit setting wins — the user has already named their helper.
  if [ -n "${SUDO_ASKPASS:-}" ] && [ -x "${SUDO_ASKPASS}" ]; then
    printf '%s\n' "$SUDO_ASKPASS"
    return 0
  fi

  # ksshaskpass on Plasma, the others on GNOME/Xfce and Debian's generic
  # alternative. Ordered so the desktop's native dialog is preferred.
  for candidate in \
    /usr/bin/ksshaskpass \
    /usr/bin/ssh-askpass \
    /usr/libexec/openssh/gnome-ssh-askpass \
    /usr/bin/lxqt-openssh-askpass \
    /usr/lib/ssh/x11-ssh-askpass; do
    if [ -x "$candidate" ]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done

  return 1
}

ensure_root() {
  if [ "$sudo_ready" -eq 1 ]; then
    return 0
  fi

  # Memoized: every unmet item below calls this, and without the latch a
  # non-interactive apply would repeat the same two-line warning once per item.
  if [ "$sudo_failed" -eq 1 ]; then
    return 1
  fi

  if [ "$(id -u)" -eq 0 ]; then
    SUDO=""
  elif sudo -n true 2>/dev/null; then
    SUDO="sudo"
  elif [ -t 0 ]; then
    note "changes needed — prompting for sudo"
    SUDO="sudo"
  elif askpass=$(find_askpass); then
    # No TTY, but this is a graphical session with an askpass helper, so a
    # password can still be collected — from a dialog instead of the terminal.
    #
    # Worth having because the no-TTY case is the normal one, not the odd one:
    # `task switch` invokes chezmoi as a subprocess, and anything driving it
    # from an editor, an agent, or a desktop launcher has no controlling
    # terminal either. Without this the run reaches the packages it must
    # install and then quits on a warning, which is exactly the state that
    # left a host with no kitty and an unsandboxed browser.
    #
    # Caching cannot substitute for it: with no TTY, sudo keys the timestamp
    # per process session rather than per terminal, so priming the cache in
    # the calling shell does not carry into chezmoi's subprocess.
    #
    # sudo consults SUDO_ASKPASS only when passed -A, and $SUDO is used both
    # bare and as the first element of an argument array. A function is the
    # one form that survives both, since bash resolves it wherever the word
    # lands in command position.
    export SUDO_ASKPASS="$askpass"
    sudo() { command sudo -A "$@"; }
    note "changes needed — prompting for sudo via $askpass"
    SUDO="sudo"
  else
    warn "changes needed but sudo is unavailable and stdin is not a TTY."
    warn "Re-run from an interactive shell, or set PROVISION_HOST_SKIP=1."
    sudo_failed=1
    return 1
  fi

  sudo_ready=1
}

unit_exists() { systemctl cat "$1" >/dev/null 2>&1; }

# --- 1. packages ------------------------------------------------------------
#
# ufw is appended to the same install pass rather than handled separately, so a
# fresh host takes one transaction and one sudo prompt for everything.

wanted=("${PACKAGES[@]}")

# Checked against the desktop that is installed, not XDG_CURRENT_DESKTOP: a
# chezmoi apply can run from a plain shell or over ssh where that is unset.
#
# Re-checked at runtime even though PLASMA_PRESENT already carries the
# render-time answer, because the two can disagree — the render happens before
# this same apply installs anything, and a desktop added between render and run
# should not be missed. Either saying yes is enough; the packages are
# no-ops when already present.
if [ "$PLASMA_PRESENT" = "yes" ] ||
  command -v plasmashell >/dev/null 2>&1 ||
  command -v kwin_wayland >/dev/null 2>&1; then
  wanted+=("${PLASMA_PACKAGES[@]}")
else
  note "skipped    ${PLASMA_PACKAGES[*]} (no Plasma on this host — will re-run if one is installed)"
fi

missing=()
for pkg in "${wanted[@]}"; do
  if pkg_installed "$pkg"; then
    note "unchanged  $pkg"
  else
    missing+=("$pkg")
  fi
done

if [ "${#missing[@]}" -gt 0 ]; then
  if ensure_root; then
    pkg_install "${missing[@]}"
    note "INSTALLED  ${missing[*]}"
  else
    warn "not installed: ${missing[*]}"
  fi
fi

# --- 1b. apparmor (unprivileged userns for Nix-built Chromium/Electron apps) -
#
# Chromium (and Electron, which embeds it) needs either a setuid sandbox
# helper or an unprivileged user namespace to sandbox its renderers. The
# setuid path is unreachable for anything built by Nix — chrome-sandbox /
# vivaldi-sandbox live in the read-only store and can never be chmod 4755 —
# so it depends on the namespace path working. Ubuntu/Debian default to
# denying that to anything without an AppArmor profile that explicitly allows
# `userns` (see kernel.apparmor_restrict_unprivileged_userns). The distro's
# own browser profiles only attach to the apt package paths (/opt/vivaldi,
# /usr/lib/slack, ...), so they never match a Nix store binary — the app gets
# no sandbox path at all and aborts on launch. Confirmed crash-looping this
# way: Vivaldi, Slack, Discord.
#
# One profile per app (rather than one wildcard covering all of /nix/store)
# so this only ever grants `userns` to the specific binaries known to need
# it, not to Nix-built software in general.
#
# Only relevant, and only installed, on a host where AppArmor is actually the
# active LSM by default (Ubuntu/Debian and derivatives). Hosts running
# something else (Arch with no LSM, Fedora with SELinux) never hit this
# restriction and must not have an AppArmor profile forced onto them.
#
# name:relative-glob-under-/nix/store, one per line.
#
# discord is deliberately bubblewrap and not the Discord binary itself: the
# nixpkgs build is an FHS-env wrapper that re-execs through bwrap, so bwrap is
# the process that asks the kernel for the namespace and therefore the one the
# profile has to attach to. Confirmed by its failure mode — "bwrap: setting up
# uid map: Permission denied", not Chromium's own sandbox message.
NIX_USERNS_APPS="
vivaldi:opt/vivaldi/vivaldi-bin
slack:lib/slack/slack
bubblewrap:bin/bwrap
"

if [ "$(cat /sys/module/apparmor/parameters/enabled 2>/dev/null)" = "Y" ] &&
  command -v apparmor_parser >/dev/null 2>&1; then
  # Heredoc, not a pipe: a pipe would run the loop in a subshell, and
  # ensure_root's sudo_ready/sudo_failed memoization (relied on by every
  # later section of this script) would be lost the moment the subshell exits.
  while IFS=: read -r app relglob; do
    [ -n "$app" ] || continue

    aa_profile="/etc/apparmor.d/nix-userns-$app"
    aa_want=$(
      cat <<EOF
# Managed by chezmoi/run_onchange_provision-linux-host.sh.tmpl in the
# nix-config repo. Grants unprivileged-userns creation to $app when built by
# Nix (the store path's hash varies by version/rebuild, hence the glob) so its
# Chromium sandbox has a working path when the setuid helper cannot be used.
abi <abi/4.0>,
include <tunables/global>

profile nix-userns-$app /nix/store/*/$relglob flags=(unconfined) {
  userns,
}
EOF
    )

    if [ -r "$aa_profile" ] && [ "$(cat "$aa_profile")" = "$aa_want" ]; then
      note "unchanged  $aa_profile"
    elif ensure_root; then
      printf '%s\n' "$aa_want" | $SUDO install -D -m 0644 -o root -g root /dev/stdin "$aa_profile"
      if $SUDO apparmor_parser -r "$aa_profile" 2>/dev/null; then
        note "INSTALLED  $aa_profile"
      else
        warn "$aa_profile written but apparmor_parser -r failed — check syntax"
      fi
    else
      warn "$aa_profile not written — $app (built by Nix) will fail its sandbox check"
    fi
  done <<EOF
$NIX_USERNS_APPS
EOF
else
  note "skipped    nix-userns-* apparmor profiles (AppArmor not the active LSM here)"
fi

# --- 1c. steam's 32-bit runtime ---------------------------------------------
#
# Steam is a 32-bit application. On a Debian/Ubuntu host that means i386 has to
# be a registered foreign architecture before apt can resolve any :i386
# dependency at all — without it dpkg does not even recognise the suffix, and
# every 32-bit package "cannot be found". That is the whole of the "missing 32
# bit libraries" complaint Steam shows on a fresh neon install.
#
# Gated on Steam actually being installed, so this stays off hosts that will
# never want it (the cloud kiosk, servers) rather than adding a second
# architecture and a mesa/llvm i386 stack to every apt box.
#
# The package list is deliberately explicit rather than delegated to Steam's own
# /usr/bin/steamdeps helper, for two independent reasons:
#
#   1. steamdeps only runs at Steam launch, and prompts interactively for root.
#      A host provisioned by this script should already be able to play.
#   2. steamdeps is broken for the repo user on any host where Nix is on PATH.
#      Its shebang is `#!/usr/bin/env python3`, so it resolves python3 through
#      PATH and gets ~/.nix-profile/bin/python3, which has no `apt` module:
#          Couldn't import apt, please install python3-apt
#      even though python3-apt is installed for the system interpreter. This is
#      the PATH-shadowing cousin of the LD_LIBRARY_PATH hazard documented in
#      home-manager/profiles/desktop-linux.nix. Pre-installing the libraries
#      makes that failure cosmetic instead of load-bearing.
#
# The list is what steamdeps itself asks for on noble (verified by running it
# under /usr/bin/python3 until it fell silent), plus the mesa 32-bit stack the
# GL side needs. steam-libs-* come from Valve's own repo, which is already
# configured wherever steam-launcher came from.

if [ "$PM" = apt ] && (pkg_installed steam-launcher || pkg_installed steam || pkg_installed steam-installer); then
  steam_i386_pkgs=(
    libc6:i386
    libegl1:i386
    libgl1:i386
    libgl1-mesa-dri:i386
    libdrm2:i386
    steam-libs-amd64
    steam-libs-i386
  )

  if ! dpkg --print-foreign-architectures 2>/dev/null | grep -qx i386; then
    if ensure_root; then
      $SUDO dpkg --add-architecture i386
      # Mandatory: the i386 package lists do not exist until an update runs
      # after the architecture is registered, so a bare install would fail.
      $SUDO apt-get update
      note "ENABLED    i386 foreign architecture (steam is installed)"
    else
      warn "steam is installed but i386 could not be enabled — 32-bit libraries will stay missing"
    fi
  else
    note "unchanged  i386 foreign architecture"
  fi

  steam_missing=()
  for p in "${steam_i386_pkgs[@]}"; do
    dpkg-query -W -f='${Status}' "$p" 2>/dev/null | grep -q "ok installed" ||
      steam_missing+=("$p")
  done

  if [ "${#steam_missing[@]}" -eq 0 ]; then
    note "unchanged  steam 32-bit runtime"
  elif ensure_root; then
    DEBIAN_FRONTEND=noninteractive $SUDO apt-get install -y "${steam_missing[@]}"
    note "INSTALLED  ${steam_missing[*]}"
  else
    warn "steam 32-bit runtime not installed: ${steam_missing[*]}"
  fi
else
  note "skipped    steam 32-bit runtime (steam not installed here)"
fi

# --- 1d. KRdp's H.264 encoder (Intel, apt hosts) ----------------------------
#
# KRdp can only send video as H.264 over RDPGFX — it implements no legacy bitmap
# or RemoteFX path — so with no working H.264 *encoder* it accepts the
# connection, authenticates it, and then transmits nothing. The client shows a
# blank white surface and neither side logs an error, because at the protocol
# level nothing failed. That is the entire symptom, and it is worth writing down
# because it looks like a network or a permissions problem and is neither.
#
# Ubuntu/neon's default intel-media-va-driver is the FREE build, which has the
# hardware encode entrypoints compiled out. The driver therefore loads happily
# and then reports no encoder, which is worse than being absent: KRdp's
# openh264 CPU fallback is for when no VA driver can be opened at all, so a
# driver that opens and offers nothing lands in neither path. Confirmed on
# aerith, whose journal repeats
#     VAAPI: entrypoint 6 of profile 6 is not supported by ... renderD128
# for every H.264 profile it probes (entrypoint 6 is VAEntrypointEncSlice).
#
# The non-free build carries the same version with encode enabled and Conflicts/
# Replaces the free one, so apt swaps them in place.
#
# Intel-only and apt-only by construction: this is a packaging split specific to
# Debian/Ubuntu's handling of Intel's media driver. AMD and NVIDIA hosts encode
# through entirely different stacks and must not be touched.

if [ "$PM" = apt ] && [ "$PLASMA_PRESENT" = "yes" ] &&
  grep -qx 0x8086 /sys/class/drm/card*/device/vendor 2>/dev/null; then
  if pkg_installed intel-media-va-driver-non-free; then
    note "unchanged  intel-media-va-driver-non-free (KRdp H.264 encode)"
  elif ! apt-cache policy intel-media-va-driver-non-free 2>/dev/null | grep -q 'Candidate: [0-9]'; then
    # multiverse is where this lives; without it there is nothing to install
    # and saying so beats a bare apt failure.
    warn "intel-media-va-driver-non-free is unavailable — enable the multiverse"
    warn "component, or KRdp will connect and show a blank screen (no H.264 encoder)"
  elif ensure_root; then
    DEBIAN_FRONTEND=noninteractive $SUDO apt-get install -y intel-media-va-driver-non-free
    note "INSTALLED  intel-media-va-driver-non-free — restart krdpserver or re-login"
  else
    warn "intel-media-va-driver-non-free not installed — KRdp will show a blank screen"
  fi
fi

# --- 1e. CDEmu virtual optical drive (bin/cue in Dolphin) -------------------
#
# bin/cue cannot be loop-mounted. The .bin holds raw 2352-byte CD sectors — a
# sync pattern, a header and ECC wrapped around each 2048-byte payload — while
# the kernel's iso9660 driver expects bare 2048-byte sectors, so `mount -o loop`
# fails on every genuine bin/cue and succeeds only on images that are really an
# ISO under a .bin name. The .cue beside it is a text sheet describing the track
# layout, not something the kernel reads at all.
#
# CDEmu solves that by being a real optical drive: the vhba module registers a
# virtual SCSI host, the daemon feeds it de-framed sectors via libmirage, and
# the kernel and udisks then treat the result exactly like a physical disc — so
# Dolphin auto-mounts it, and audio and multi-track discs survive, which
# converting to ISO with bchunk would not. .local/bin/cdemu-mount and the
# Dolphin service menu beside it are the front end; this section is what makes
# them work.
#
# Plasma-gated for the same reason as PLASMA_PACKAGES: the payoff is the Dolphin
# right-click, and a headless host has no business building a DKMS module for a
# virtual CD drive it will never open. The render-time PLASMA_PRESENT answer is
# re-checked at runtime for the same reason as section 1.
#
# Kept out of the section 1 install pass on purpose. pkg_install sends every
# missing package in one transaction, and akmod-vhba lives in RPM Fusion rather
# than Fedora proper — one unavailable package there would fail the transaction
# and take sshd, ufw and kitty down with it.

if [ "$PLASMA_PRESENT" = "yes" ] ||
  command -v plasmashell >/dev/null 2>&1 ||
  command -v kwin_wayland >/dev/null 2>&1; then

  CDEMU_PACKAGES=(cdemu-client cdemu-daemon vhba)

  # libmirage is a hard dependency of cdemu-daemon on all three distros and is
  # left to the package manager rather than named here.
  cdemu_missing=()
  for pkg in "${CDEMU_PACKAGES[@]}"; do
    if pkg_installed "$pkg"; then
      note "unchanged  $(pkg_name "$pkg")"
    else
      cdemu_missing+=("$pkg")
    fi
  done

  if [ "${#cdemu_missing[@]}" -gt 0 ]; then
    if [ "$PM" = dnf ] && ! dnf list --available akmod-vhba >/dev/null 2>&1; then
      # RPM Fusion free is where this lives; without it there is nothing to
      # install and saying so beats a bare dnf failure.
      warn "akmod-vhba is unavailable — enable the RPM Fusion free repository,"
      warn "or disc images will have to be converted with bchunk instead"
      cdemu_missing=()
    elif ensure_root; then
      pkg_install "${cdemu_missing[@]}"
      note "INSTALLED  ${cdemu_missing[*]} (CDEmu virtual optical drive)"
    else
      warn "not installed: ${cdemu_missing[*]} — bin/cue will not mount"
      cdemu_missing=()
    fi
  fi

  # vhba has no autoload trigger — nothing probes for a virtual SCSI adapter —
  # so without this the first cdemu call after every reboot fails on a missing
  # /dev/vhba_ctl.
  VHBA_CONF=/etc/modules-load.d/vhba.conf
  if [ -f "$VHBA_CONF" ] && grep -qx vhba "$VHBA_CONF" 2>/dev/null; then
    note "unchanged  $VHBA_CONF"
  elif ensure_root; then
    printf 'vhba\n' | $SUDO tee "$VHBA_CONF" >/dev/null
    note "WROTE      $VHBA_CONF (load the virtual SCSI adapter at boot)"
  else
    warn "$VHBA_CONF not written — vhba will need a manual modprobe each boot"
  fi

  # Load it now too, so this works without a reboot. Skipped when the module is
  # not built yet: a DKMS package installed seconds ago in this same run may
  # still be compiling, and a failed modprobe here would be noise, not news.
  if [ -e /dev/vhba_ctl ]; then
    note "unchanged  vhba module loaded"
  elif modinfo vhba >/dev/null 2>&1 && ensure_root; then
    if $SUDO modprobe vhba 2>/dev/null; then
      note "LOADED     vhba"
    else
      warn "modprobe vhba failed — if DKMS just built it, reboot and re-check"
    fi
  fi

  # /dev/vhba_ctl is root-owned with a group taken from the module's own udev
  # rule, and that group differs by distro (Arch has no `cdrom` group at all —
  # it uses `optical`). Read it out of the rule rather than guessing, so this
  # stays correct wherever it runs.
  vhba_group=$(sed -n 's/.*GROUP="\([^"]*\)".*/\1/p' \
    /usr/lib/udev/rules.d/*vhba*.rules /lib/udev/rules.d/*vhba*.rules \
    /etc/udev/rules.d/*vhba*.rules 2>/dev/null | head -1 || true)

  if [ -n "$vhba_group" ] && getent group "$vhba_group" >/dev/null 2>&1; then
    cdemu_user=$(id -un)
    if id -nG "$cdemu_user" 2>/dev/null | tr ' ' '\n' | grep -qx "$vhba_group"; then
      note "unchanged  $cdemu_user in group $vhba_group"
    elif ensure_root; then
      $SUDO usermod -aG "$vhba_group" "$cdemu_user"
      # Group membership is established at login, so the running session cannot
      # see it. Without this line the next cdemu call fails on a permission
      # error that looks like a broken install rather than a stale session.
      note "ADDED      $cdemu_user to group $vhba_group — log out and back in"
    else
      warn "$cdemu_user is not in group $vhba_group — /dev/vhba_ctl will be unwritable"
    fi
  fi
fi

# --- 2. repo user ------------------------------------------------------------
#
# Created only when missing, and never modified if it already exists — this must
# not touch the account it is running as on an established host.
#
# The password is deliberately left unset, so the account starts with no
# password login at all and is reachable only by the remoting key seeded below.
# That has two consequences worth knowing rather than discovering: sudo will
# refuse until a password is set, and KRdp's SystemUserEnabled auth (which is
# PAM against this very account) has nothing to authenticate against. Both are
# fixed by one `passwd`, which the warning below spells out.

# Arch and Fedora put admins in wheel; Debian and its derivatives use sudo.
case "$PM" in
apt) admin_group=sudo ;;
*) admin_group=wheel ;;
esac

repo_user_home=""
if id -u "$REPO_USER" >/dev/null 2>&1; then
  note "unchanged  user $REPO_USER"
  repo_user_home=$(getent passwd "$REPO_USER" | cut -d: -f6)
elif ensure_root; then
  # zsh is what the repo configures as the login shell, but it is not
  # guaranteed present on a host being bootstrapped; bash keeps the account
  # usable either way and a later switch can change it.
  if command -v zsh >/dev/null 2>&1; then
    login_shell=$(command -v zsh)
  else
    login_shell=/bin/bash
  fi

  useradd_args=(--create-home --shell "$login_shell")
  if getent group "$admin_group" >/dev/null 2>&1; then
    useradd_args+=(--groups "$admin_group")
  else
    warn "group $admin_group missing — $REPO_USER created without admin rights"
  fi

  $SUDO useradd "${useradd_args[@]}" "$REPO_USER"
  repo_user_home=$(getent passwd "$REPO_USER" | cut -d: -f6)
  note "CREATED    user $REPO_USER (shell $login_shell, group $admin_group)"

  warn "$REPO_USER has no password yet. sudo and KRdp system-user auth both"
  warn "need one. Set it with:  sudo passwd $REPO_USER"
  warn "Then: su - $REPO_USER, clone this repo, and run task home-switch."
else
  warn "$REPO_USER does not exist and could not be created"
fi

if ! command -v ufw >/dev/null 2>&1; then
  warn "ufw still absent — skipping firewall configuration"
  note "done"
  exit 0
fi

# --- 3. ufw as the only firewall --------------------------------------------
#
# Masked, not just disabled: firewalld in particular gets pulled back in as a
# dependency by desktop and container packages, and a plain `disable` would let
# it start again on the next such install and fight ufw over the same tables.

for unit in "${CONFLICTING_FIREWALLS[@]}"; do
  unit_exists "$unit.service" || continue

  state=$(systemctl is-enabled "$unit.service" 2>/dev/null || true)
  if [ "$state" = "masked" ]; then
    note "unchanged  $unit (masked)"
    continue
  fi

  if ensure_root; then
    $SUDO systemctl disable --now "$unit.service" >/dev/null 2>&1 || true
    $SUDO systemctl mask "$unit.service" >/dev/null 2>&1 || true
    note "MASKED     $unit (was: ${state:-unknown})"
  else
    warn "$unit still active alongside ufw"
  fi
done

# --- 4. ssh ------------------------------------------------------------------
#
# Strict ordering: authorize the key, THEN disable password auth, THEN start the
# daemon. Any other order either opens a password-authenticating sshd to the
# network for a window, or produces a running sshd with no way to log into it.

ssh_dir="$HOME/.ssh"
auth_keys="$ssh_dir/authorized_keys"

# authorize_key <authorized_keys path> <owner> <label>
# Owner is passed explicitly because this also writes into another account's
# home when the apply is running as someone other than REPO_USER.
authorize_key() {
  local target=$1 owner=$2 label=$3 dir tmp key_body as_owner=()

  dir=$(dirname "$target")

  # Writing into another user's home needs root, and the result must end up
  # owned by them or sshd ignores it (StrictModes).
  if [ "$owner" != "$(id -un)" ]; then
    ensure_root || {
      warn "cannot authorize remoting key for $label"
      return 1
    }
    as_owner=("$SUDO" -u "$owner")
  fi

  if [ -e "$target" ] && "${as_owner[@]}" grep -qxF "$REMOTING_KEY" "$target" 2>/dev/null; then
    note "unchanged  authorized_keys ($label)"
    return 0
  fi

  "${as_owner[@]}" install -d -m 0700 "$dir"

  # Drop any earlier line carrying this same key with different options, so
  # rotating the options does not leave the looser copy behind and still
  # honoured. Comparison is on the key body, not the whole line.
  key_body=$(printf '%s' "$REMOTING_KEY" | awk '{print $2, $3}')
  tmp=$(mktemp)
  if [ -e "$target" ]; then
    "${as_owner[@]}" grep -vF "$key_body" "$target" >"$tmp" 2>/dev/null || true
  fi
  printf '%s\n' "$REMOTING_KEY" >>"$tmp"

  "${as_owner[@]}" install -m 0600 "$tmp" "$target"
  rm -f "$tmp"
  note "AUTHORIZED remoting key ($label)"
}

authorize_key "$auth_keys" "$(id -un)" "$(id -un)"

# On a host being bootstrapped under a different login (graha's "ansible"), the
# account that will actually be remoted into is REPO_USER, not the one running
# this. Authorize both: the current user so this session keeps working, and
# REPO_USER so `ssh <host>` lands where home-manager is configured.
if [ -n "$repo_user_home" ] && [ "$REPO_USER" != "$(id -un)" ]; then
  authorize_key "$repo_user_home/.ssh/authorized_keys" "$REPO_USER" "$REPO_USER" || true
fi

# Password auth comes off only once a key is actually authorized — otherwise
# this would produce a host nobody can log into. Mirrors the same derivation in
# modules/services/sshd.nix.
if [ -s "$auth_keys" ]; then
  password_auth=no
else
  password_auth=yes
  warn "no authorized key present — leaving PasswordAuthentication on"
fi

# 10- so it sorts ahead of the distro's own drop-ins: sshd takes the FIRST
# value seen for most keywords, and /etc/ssh/sshd_config Includes
# sshd_config.d/*.conf in glob order before its own directives.
sshd_conf=/etc/ssh/sshd_config.d/10-nix-config.conf
sshd_want=$(
  cat <<EOF
# Managed by chezmoi/run_onchange_provision-linux-host.sh.tmpl in the
# nix-config repo. Mirrors modules/services/sshd.nix on the NixOS hosts.
PermitRootLogin no
PasswordAuthentication ${password_auth}
KbdInteractiveAuthentication no

# Required, not incidental: forwarding is how KRdp and every other closed port
# is reached. GatewayPorts stays off so a forward cannot be re-exported.
AllowTcpForwarding yes
GatewayPorts no

AllowAgentForwarding no
X11Forwarding no

MaxAuthTries 3
LoginGraceTime 30
EOF
)

# A drop-in is only read if the main config Includes the directory. Every
# current distro does, but an older or hand-edited sshd_config may not, and the
# failure is silent — the file sits there looking applied while sshd ignores it.
if [ -r /etc/ssh/sshd_config ] &&
  ! grep -qE '^[[:space:]]*Include[[:space:]]+/etc/ssh/sshd_config\.d/' /etc/ssh/sshd_config; then
  warn "/etc/ssh/sshd_config has no Include for sshd_config.d/ — the drop-in"
  warn "below will be ignored. Add: Include /etc/ssh/sshd_config.d/*.conf"
fi

if [ -r "$sshd_conf" ] && [ "$(cat "$sshd_conf")" = "$sshd_want" ]; then
  note "unchanged  $sshd_conf"
elif ensure_root; then
  printf '%s\n' "$sshd_want" | $SUDO install -D -m 0644 -o root -g root /dev/stdin "$sshd_conf"
  note "INSTALLED  $sshd_conf"
  sshd_changed=1
else
  warn "$sshd_conf not written — sshd keeps its distro defaults"
fi

# Arch names the unit sshd.service; Debian and its derivatives name it
# ssh.service (older releases have no sshd.service alias at all). Resolve it
# rather than assuming, or this silently does nothing on a Mint/Ubuntu host.
sshd_unit=""
for candidate in sshd.service ssh.service; do
  if unit_exists "$candidate"; then
    sshd_unit=$candidate
    break
  fi
done

if [ -n "$sshd_unit" ]; then
  if systemctl is-active --quiet "$sshd_unit" 2>/dev/null; then
    # Config changes need a reload; sshd keeps existing sessions across it.
    if [ "${sshd_changed:-0}" = "1" ] && ensure_root; then
      $SUDO systemctl reload "$sshd_unit"
      note "RELOADED   $sshd_unit (config changed)"
    else
      note "unchanged  $sshd_unit (active)"
    fi
  elif ensure_root; then
    $SUDO systemctl enable --now "$sshd_unit"
    note "ENABLED    $sshd_unit"
  else
    warn "sshd not started"
  fi
else
  warn "no sshd/ssh unit — the ssh server package may have failed to install"
fi

# --- 5. firewall rules ------------------------------------------------------
#
# Rules go in BEFORE ufw is enabled. Enabling ufw sets default-deny inbound, so
# adding rules afterwards would leave a window where a remote session could be
# cut — and on a headless box that window is permanent.
#
# /etc/ufw/user.rules is world-readable on Arch but 0640 on Debian; the
# readable path keeps a provisioned host from prompting for sudo on every
# apply, and the fallback only costs a prompt where we would likely need one.

rule_present() {
  local port=$1
  if [ -r /etc/ufw/user.rules ]; then
    grep -qE "^### tuple ### allow tcp ${port}\b" /etc/ufw/user.rules
  else
    ensure_root || return 1
    $SUDO ufw status 2>/dev/null | grep -qE "^${port}/tcp\b"
  fi
}

add_rule() {
  local port=$1 comment=$2
  if rule_present "$port"; then
    note "unchanged  ufw allow ${port}/tcp (${comment})"
    return 0
  fi

  if ensure_root; then
    $SUDO ufw allow "${port}/tcp" >/dev/null
    note "OPENED     ufw allow ${port}/tcp (${comment})"
  else
    warn "ufw ${port}/tcp not opened — ${comment} unreachable from the LAN"
  fi
}

# 22 unconditionally: it is the only door in, and it must be open before ufw
# flips to default-deny or a remote apply severs the session running it.
add_rule 22 "sshd — tunnel endpoint"

if [ "${#FIREWALL_TCP[@]}" -gt 0 ]; then
  for entry in "${FIREWALL_TCP[@]}"; do
    add_rule "${entry%% *}" "${entry#* }"
  done
fi

# --- 6. enable ufw ----------------------------------------------------------

# Whether ufw is ENFORCING, which is not what `systemctl is-active ufw` answers.
#
# The unit reports active whenever it has been started, including when ufw's own
# ENABLED flag is "no" -- the unit's job is to restore saved state at boot, and
# restoring "off" is a successful run. `ufw enable` flips ENABLED in
# /etc/ufw/ufw.conf, and that flag is what decides whether rules are loaded.
#
# Checking the unit therefore reported a working firewall on hosts that had
# none: both neon hosts (cloud, aerith) sat at ENABLED=no with the unit active
# and this script printing "unchanged ufw (active)" on every run. That matters
# more here than a normal bug, because the closed port IS the security model --
# krdpserver binds 0.0.0.0:3389 with no bind-address setting, so an unenforced
# ufw silently publishes a full desktop-takeover channel to the LAN. Confirmed
# on aerith: 3389 answered from two other hosts until ufw was actually enabled.
#
# /etc/ufw/ufw.conf is world-readable (0644), so this stays a root-free check
# and an already-provisioned host still never prompts for sudo.
ufw_enforcing() {
  grep -qE '^ENABLED=yes[[:space:]]*$' /etc/ufw/ufw.conf 2>/dev/null
}

if ufw_enforcing; then
  note "unchanged  ufw (enforcing)"
else
  if ensure_root; then
    # --force skips the "this may disrupt existing ssh connections" prompt,
    # which the rules above have already accounted for.
    $SUDO ufw --force enable >/dev/null
    $SUDO systemctl enable ufw >/dev/null 2>&1 || true
    note "ENABLED    ufw (was installed but not enforcing)"
  else
    warn "ufw is NOT enforcing and could not be enabled — service ports are"
    warn "exposed to the LAN, which this repo's remoting model assumes they are not"
  fi
fi

# --- 7. wake-on-lan ---------------------------------------------------------
#
# Arm the wired NIC to power the machine back on from a magic packet. Same
# policy and same shape as modules/networking/wake-on-lan.nix on the NixOS host
# — keep the two in step.
#
# A NetworkManager connection default rather than a per-interface ethtool unit:
# it matches on device *type*, so it covers whatever wired NIC is present
# without an interface name written down anywhere, and NetworkManager re-applies
# it on every activation, which is what re-arms it at each boot. Nothing clears
# it at poweroff (connection.down-on-poweroff is off by default), so the flag is
# still set in the NIC at S5, which is the point.
#
# Wired only. WoWLAN is a separate feature with its own flags, and a sleeping
# card that has dropped its association has nothing to receive the packet on.
#
# No firewall rule is needed and none is added: while the host is off the packet
# is consumed by the NIC and the OS never sees it, and while the host is up
# there is nothing to wake. ufw dropping UDP/9 is the correct outcome.
#
# Firmware still has the last word. A board with "Wake on PCIe/LAN" disabled, or
# ErP/Deep Sleep enabled, cuts NIC power at S5 and nothing here survives it. A
# host that wakes from suspend but not from a full power-off has that setting to
# fix, not this script.

readonly WOL_CONF=/etc/NetworkManager/conf.d/wake-on-lan.conf

wol_conf() {
  cat <<'EOF'
# Managed by chezmoi (run_onchange_provision-linux-host.sh.tmpl) — edits are
# overwritten. NixOS equivalent: modules/networking/wake-on-lan.nix.
[connection-wake-on-lan]
match-device=type:ethernet
ethernet.wake-on-lan=magic
EOF
}

# Root-free: conf.d files are 0644, and nmcli reads device status without
# privilege. ethtool's Wake-on line does need root, so it is only consulted on
# the mutating path below — an already-provisioned host must never prompt.
wired_devices() {
  nmcli -t -f DEVICE,TYPE device status 2>/dev/null | awk -F: '$2 == "ethernet" { print $1 }'
}

# ethtool comes from the nix user profile (home-manager/home.nix), and sudo
# resets PATH to its compiled-in secure_path, which contains no nix profile. A
# bare `$SUDO ethtool` is therefore "command not found" on every host here, not
# just the ones without ethtool. Resolve it in the caller's PATH and hand sudo
# the absolute path instead. Empty means genuinely absent.
ETHTOOL=$(command -v ethtool 2>/dev/null || true)

if ! command -v nmcli >/dev/null 2>&1; then
  warn "NetworkManager not present — wake-on-lan not configured"
elif wol_conf | cmp -s - "$WOL_CONF" 2>/dev/null; then
  note "unchanged  wake-on-lan (NetworkManager default, wired)"
elif ensure_root; then
  wol_conf | $SUDO tee "$WOL_CONF" >/dev/null
  $SUDO chmod 644 "$WOL_CONF"

  # Re-reads NetworkManager.conf without touching any connection. Deliberately
  # NOT `nmcli con up`: that would bounce the link, and this script is run over
  # ssh on the headless hosts, where dropping the link severs the session
  # running it. The new default therefore takes effect at the next activation,
  # and ethtool below covers the gap until then.
  $SUDO nmcli general reload conf 2>/dev/null || true

  note "WROTE      $WOL_CONF (wired NICs wake on magic packet)"

  for dev in $(wired_devices); do
    if [ -z "$ETHTOOL" ]; then
      warn "$dev: ethtool not found — armed at the next NetworkManager activation, not now"
      continue
    fi

    # `|| true` is load-bearing: under `set -o pipefail` a failing ethtool makes
    # the whole pipeline non-zero, which makes this assignment non-zero, which
    # errexit turns into a silent abort of the entire script — before the empty
    # arm below can report anything. That is what killed the run that first hit
    # `sudo ethtool` not being on secure_path.
    supports=$($SUDO "$ETHTOOL" "$dev" 2>/dev/null | sed -n 's/^[[:space:]]*Supports Wake-on:[[:space:]]*//p' || true)
    case "$supports" in
    *g*)
      # Applied live so the host is wakeable now rather than after its next
      # reboot — which, for a host you are configuring precisely because you
      # keep having to walk over to it, is the whole difference.
      if $SUDO "$ETHTOOL" -s "$dev" wol g 2>/dev/null; then
        note "ARMED      $dev wol g"
      else
        warn "$dev: ethtool could not set wol g"
      fi
      ;;
    "")
      warn "$dev: could not read Wake-on support from ethtool"
      ;;
    *)
      # pumbg is the usual full set; a NIC without 'g' cannot do magic packets
      # at all and no amount of configuration will wake it.
      warn "$dev: NIC does not support magic-packet wake (Supports Wake-on: $supports)"
      ;;
    esac
  done
else
  warn "wake-on-lan not configured — this host will not answer a magic packet"
fi

# A magic packet is addressed to a MAC and is sent to a host that is off, so
# nothing can discover the address at send time. It has to be recorded while the
# host is up or it cannot be recorded at all — which is exactly how aerith ended
# up unwakeable. Only nags for a host already in the inventory, and stops as
# soon as the line is added.
wol_toml="/home/$REPO_USER/.config/ssh/hosts.toml"
if [ -r "$wol_toml" ] && grep -q "^\[hosts\.$(hostname -s)\]" "$wol_toml" 2>/dev/null; then
  for dev in $(wired_devices); do
    mac=$(cat "/sys/class/net/$dev/address" 2>/dev/null) || continue
    [ -n "$mac" ] || continue
    if ! grep -qi "$mac" "$wol_toml"; then
      note "hosts.toml has no mac for this host — add to [hosts.$(hostname -s)]:"
      note "    mac = \"$mac\"          # $dev"
    fi
  done
fi

# --- 8. wifi remoting policy (opt-in hosts only) ----------------------------
#
# For a host with no wired NIC, section 7 can never apply. WoWLAN is the only
# remaining wake path, and it carries a hard constraint that shapes this whole
# section: it works from SUSPEND ONLY. A suspended card stays powered and stays
# associated to the AP, so it can still see a frame addressed to it. A card in
# S5 is unpowered and associated to nothing — there is no wireless equivalent of
# the wired NIC's standby listening.
#
# Three settings, none of which is much use alone: arm WoWLAN, make the power
# button suspend rather than shut down on AC, and turn wifi power-save off so
# the session is actually usable once connected. See WIFI_REMOTE_HOSTS at the
# top for the measurements behind the last one and why membership is per-host.

if printf '%s\n' "${WIFI_REMOTE_HOSTS[@]}" | grep -qx "$(hostname -s)"; then
  WOWLAN_CONF=/etc/NetworkManager/conf.d/wake-on-wlan.conf

  wowlan_conf() {
    cat <<'EOF'
# Managed by chezmoi (run_onchange_provision-linux-host.sh.tmpl) — edits are
# overwritten. Wireless sibling of wake-on-lan.conf; works from suspend only.
[connection-wake-on-wlan]
match-device=type:wifi
wifi.wake-on-wlan=magic
EOF
  }

  if ! command -v nmcli >/dev/null 2>&1; then
    warn "NetworkManager not present — wake-on-wlan not configured"
  elif wowlan_conf | cmp -s - "$WOWLAN_CONF" 2>/dev/null; then
    note "unchanged  wake-on-wlan (NetworkManager default, wifi)"
  elif ensure_root; then
    wowlan_conf | $SUDO tee "$WOWLAN_CONF" >/dev/null
    $SUDO chmod 644 "$WOWLAN_CONF"
    $SUDO nmcli general reload conf 2>/dev/null || true
    note "WROTE      $WOWLAN_CONF (wifi wakes on magic packet, from suspend)"

    # Capability check, not an assumption. iwlwifi advertises
    # WIPHY_WOWLAN_MAGIC_PKT on most cards but it is firmware-dependent, and a
    # card that cannot do it would otherwise fail silently at the one moment it
    # matters — with the host asleep and unreachable, which is the worst
    # possible place to find out.
    if command -v iw >/dev/null 2>&1; then
      if iw phy0 info 2>/dev/null | grep -qi "magic-packet"; then
        note "SUPPORTED  phy0 advertises WoWLAN magic-packet"
      else
        warn "phy0 does NOT advertise WoWLAN magic-packet — this host cannot be"
        warn "woken over wifi regardless of the setting just written"
      fi
    else
      note "install iw to verify:  iw phy0 info | grep -i magic-packet"
    fi
  else
    warn "wake-on-wlan not configured — this host cannot be woken over wifi"
  fi

  # Wifi power-save off — the interactive-latency fix. See WIFI_REMOTE_HOSTS.
  #
  # The filename must sort AFTER the distro's own
  # /etc/NetworkManager/conf.d/default-wifi-powersave-on.conf, which sets
  # wifi.powersave = 3 in the same [connection] section: NM reads conf.d in
  # alphabetical order and later files win for the same key. A numeric prefix
  # would be WRONG here — digits sort before letters, so 99-*.conf would lose
  # to default-*.conf. Hence "zz-".
  #
  # 2 is "disable", 3 is "enable" in NM's powersave enum.
  WIFI_PS_CONF=/etc/NetworkManager/conf.d/zz-wifi-powersave-off.conf

  wifi_ps_conf() {
    cat <<'EOF'
# Managed by chezmoi (run_onchange_provision-linux-host.sh.tmpl) — edits are
# overwritten. Overrides default-wifi-powersave-on.conf; must sort after it.
[connection]
wifi.powersave = 2
EOF
  }

  if ! command -v nmcli >/dev/null 2>&1; then
    : # already warned above
  elif wifi_ps_conf | cmp -s - "$WIFI_PS_CONF" 2>/dev/null; then
    note "unchanged  wifi power-save disabled"
  elif ensure_root; then
    wifi_ps_conf | $SUDO tee "$WIFI_PS_CONF" >/dev/null
    $SUDO chmod 644 "$WIFI_PS_CONF"
    $SUDO nmcli general reload conf 2>/dev/null || true
    note "WROTE      $WIFI_PS_CONF"

    # Applied live as well: NM sets powersave when it ACTIVATES a connection, so
    # a config reload alone leaves the current session exactly as slow as it was
    # — and bouncing the connection to fix that would sever the ssh running this.
    for wdev in $(nmcli -t -f DEVICE,TYPE device status 2>/dev/null | awk -F: '$2 == "wifi" { print $1 }'); do
      if command -v iw >/dev/null 2>&1; then
        $SUDO iw dev "$wdev" set power_save off 2>/dev/null || true
      elif command -v iwconfig >/dev/null 2>&1; then
        $SUDO iwconfig "$wdev" power off 2>/dev/null || true
      fi

      # Verified, not assumed. The conf.d ordering above is the fragile part of
      # this — a rename of the distro file, or NM changing precedence, would
      # silently restore the 28x latency penalty with nothing to show for it.
      if iwconfig "$wdev" 2>/dev/null | grep -qi "power management:off"; then
        note "OFF        $wdev power-save (latency fix applied)"
      else
        warn "$wdev power-save is still ON — check that $WIFI_PS_CONF still sorts"
        warn "after default-wifi-powersave-on.conf in /etc/NetworkManager/conf.d"
      fi
    done
  else
    warn "wifi power-save left on — remote desktop latency will stay poor"
  fi

  # Power-button policy. PowerDevil, not logind: on a Plasma session PowerDevil
  # holds a *block* inhibitor on handle-power-key and handle-lid-switch, so
  # logind's HandlePowerKey is overridden and editing it would be a silent
  # no-op. Verified on aerith with `systemd-inhibit --list`.
  #
  # kwriteconfig6 rather than writing powerdevilrc directly, so every other
  # profile and key in that file survives — it merges one key in place. Runs as
  # the user; this is per-user config and needs no root.
  #
  # 1 is "sleep to RAM" and 8 is "shut down" in PowerDevil's SuspendType enum
  # (aerith was at 8 on battery, unset on AC). Only [AC] is touched: on battery
  # shutting down is the right answer, and a WoWLAN card held powered by a
  # suspend nobody will wake it from is pure drain.
  if command -v kwriteconfig6 >/dev/null 2>&1; then
    pd_now=$(kreadconfig6 --file powerdevilrc --group AC --group SuspendAndShutdown --key PowerButtonAction 2>/dev/null || true)
    if [ "$pd_now" = "1" ]; then
      note "unchanged  power button sleeps on AC"
    else
      kwriteconfig6 --file powerdevilrc --group AC --group SuspendAndShutdown --key PowerButtonAction 1
      note "SET        power button sleeps on AC (was: ${pd_now:-unset})"

      # PowerDevil reloads on this call; without it the change waits for the
      # next login.
      qdbus org.kde.Solid.PowerManagement /org/kde/Solid/PowerManagement \
        org.kde.Solid.PowerManagement.refreshStatus >/dev/null 2>&1 || true
    fi
  else
    warn "kwriteconfig6 missing — power-button policy unchanged, so this host may"
    warn "still be shut down rather than suspended and become unwakeable"
  fi
fi

note "done"
