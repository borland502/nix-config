#!/usr/bin/env bash
# Source this file from the current interactive shell (bash or zsh):
#   source ~/.local/lib/kion-aws-cache [dump|load|clear|status|ensure]

_kion_aws_cache_main() {
	# zsh-only hardening; skipped under bash (which lacks setopt).
	if [ -n "${ZSH_VERSION:-}" ]; then
		setopt localoptions no_unset 2>/dev/null || true
	fi

	local cache_root="$HOME/.cache/kion-aws-cache"
	local cache_parent="${cache_root%/*}"
	local cache_name="${cache_root##*/}"
	local generation_prefix=".$cache_name.generation-"
	local -a vars=(AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN)
	local command="${1:-help}"
	local cache_helper_path cache_lock_command
	if [ -n "${_kac_helper_path:-}" ]; then
		cache_helper_path="$_kac_helper_path"
	elif [ -n "${BASH_SOURCE:-}" ]; then
		cache_helper_path="${BASH_SOURCE[0]}"
	elif [ -n "${ZSH_VERSION:-}" ]; then
		cache_helper_path="$(eval 'printf "%s" "${(%):-%x}"')"
	else
		cache_helper_path="$0"
	fi
	cache_lock_command="${cache_helper_path%/*/*}/bin/kion-aws-cache-lock"

	# Harden against PATH-stripped subshells (bare `zsh -c`, `env -i`, sudo):
	# prepend the dirs that hold kion-aws-refresh/aws so validate/refresh still resolve.
	# `local` keeps the caller's PATH untouched; exported AWS_* still persist.
	local PATH="$PATH" tool_dir
	# zsh's `local` drops the export attribute (bash keeps it), so without this
	# every child would inherit no PATH at all — the lock helper's
	# `#!/usr/bin/env python3` would then fall back to /usr/bin/python3 and die
	# with "tool 'python3' not found". The export stays function-scoped, so the
	# caller's PATH is still restored on return.
	export PATH
	for tool_dir in \
		/opt/homebrew/bin \
		"/etc/profiles/per-user/${USER:-$(id -un)}/bin" \
		/run/current-system/sw/bin \
		"$HOME/.nix-profile/bin"; do
		if [[ -d "$tool_dir" && ":$PATH:" != *":$tool_dir:"* ]]; then
			PATH="$tool_dir:$PATH"
		fi
	done

	# Portable indirect read: print the value of the variable named $1. bash has
	# ${!name}, zsh has ${(P)name}; eval is the common denominator for both.
	_kion_aws_cache_get() {
		eval "printf '%s' \"\${$1:-}\""
	}

	_kion_aws_cache_usage() {
		cat <<'EOF'
Usage:
  source ~/.local/lib/kion-aws-cache [command]

Commands:
  ensure  Load valid creds into current shell, refreshing via kion-aws-refresh if needed.
          Preferred entry point: run before the first aws call, check its exit
          code (source ~/.local/bin/kac ensure && aws ...).
  dump    Dump current AWS vars to cache files if they are still valid.
  load    Load AWS vars from cache files (validates but does NOT refresh;
          fails on expired creds — prefer ensure).
  clear   Remove cached AWS vars and unset them from the current shell.
  status  Print whether current and cached credentials appear valid.
EOF
	}

	_kion_aws_cache_require_sourced() {
		if ! (return 0 2>/dev/null); then
			echo "This helper must be sourced, not executed." >&2
			echo "Use: source ~/.local/lib/kion-aws-cache [command]" >&2
			exit 1
		fi
	}

	_kion_aws_cache_has_values() {
		local name
		for name in "${vars[@]}"; do
			[[ -n "$(_kion_aws_cache_get "$name")" ]] || return 1
		done
	}

	_kion_aws_cache_cache_has_values() {
		local name file
		for name in "${vars[@]}"; do
			file="$cache_root/$name"
			[[ -s "$file" ]] || return 1
		done
	}

	_kion_aws_cache_validate_values() {
		local access_key_id="$1"
		local secret_access_key="$2"
		local session_token="$3"

		[[ -n "$access_key_id" && -n "$secret_access_key" && -n "$session_token" ]] || return 1

		AWS_ACCESS_KEY_ID="$access_key_id" \
			AWS_SECRET_ACCESS_KEY="$secret_access_key" \
			AWS_SESSION_TOKEN="$session_token" \
			aws sts get-caller-identity >/dev/null 2>&1
	}

	_kion_aws_cache_validate_current() {
		_kion_aws_cache_has_values || return 1
		_kion_aws_cache_validate_values \
			"${AWS_ACCESS_KEY_ID:-}" \
			"${AWS_SECRET_ACCESS_KEY:-}" \
			"${AWS_SESSION_TOKEN:-}"
	}

	_kion_aws_cache_mkdir() {
		umask 077
		mkdir -p "$cache_root"
		chmod 700 "$cache_root" 2>/dev/null || true
	}

	_kion_aws_cache_run_locked() {
		local worker_command="$1"

		if [[ ! -x "$cache_lock_command" ]]; then
			echo "Kion credential cache lock helper is not installed." >&2
			return 1
		fi
		umask 077
		mkdir -p "$cache_parent"
		AWS_ACCESS_KEY_ID='' \
			AWS_SECRET_ACCESS_KEY='' \
			AWS_SESSION_TOKEN='' \
			"$cache_lock_command" \
			"$cache_root" \
			bash --noprofile --norc -c \
			"source \"\$1\" \"\$2\"" \
			kion-aws-cache-worker \
			"$cache_helper_path" \
			"$worker_command"
	}

	_kion_aws_cache_dump_locked() {
		local access_key_id secret_access_key session_token
		[[ "${KION_AWS_CACHE_LOCKED:-}" == 1 ]] || return 1
		IFS= read -r -d '' access_key_id || return 1
		IFS= read -r -d '' secret_access_key || return 1
		IFS= read -r -d '' session_token || return 1
		_kion_aws_cache_mkdir
		printf '%s' "$access_key_id" >"$cache_root/AWS_ACCESS_KEY_ID"
		printf '%s' "$secret_access_key" >"$cache_root/AWS_SECRET_ACCESS_KEY"
		printf '%s' "$session_token" >"$cache_root/AWS_SESSION_TOKEN"
		chmod 600 "$cache_root/AWS_ACCESS_KEY_ID" \
			"$cache_root/AWS_SECRET_ACCESS_KEY" \
			"$cache_root/AWS_SESSION_TOKEN" 2>/dev/null || true
	}

	_kion_aws_cache_dump() {
		if ! _kion_aws_cache_validate_current; then
			echo "Current AWS credentials are expired; nothing dumped." >&2
			echo "Use: source ~/.local/bin/kac ensure   (refreshes via kion-aws-refresh)" >&2
			return 1
		fi

		if ! printf '%s\0%s\0%s\0' \
			"${AWS_ACCESS_KEY_ID:-}" \
			"${AWS_SECRET_ACCESS_KEY:-}" \
			"${AWS_SESSION_TOKEN:-}" |
			_kion_aws_cache_run_locked __dump_locked; then
			return 1
		fi
	}

	_kion_aws_cache_load() {
		_kion_aws_cache_cache_has_values || {
			echo "Cached AWS credentials were not found in $cache_root." >&2
			return 1
		}

		local access_key_id secret_access_key session_token
		access_key_id="$(<"$cache_root/AWS_ACCESS_KEY_ID")"
		secret_access_key="$(<"$cache_root/AWS_SECRET_ACCESS_KEY")"
		session_token="$(<"$cache_root/AWS_SESSION_TOKEN")"

		if ! _kion_aws_cache_validate_values "$access_key_id" "$secret_access_key" "$session_token"; then
			echo "Cached AWS credentials are expired; 'load' does not refresh." >&2
			echo "Use: source ~/.local/bin/kac ensure   (refreshes via kion-aws-refresh)" >&2
			return 1
		fi

		export AWS_ACCESS_KEY_ID="$access_key_id"
		export AWS_SECRET_ACCESS_KEY="$secret_access_key"
		export AWS_SESSION_TOKEN="$session_token"
	}

	_kion_aws_cache_remove_generation() {
		local path="$1"
		local path_parent="${path%/*}"
		local path_name="${path##*/}"

		if [[ "$path_parent" != "$cache_parent" || "$path_name" != "$generation_prefix"* ]]; then
			echo "Refusing credential generation outside $cache_parent." >&2
			return 1
		fi
		rm -rf -- "$path"
	}

	_kion_aws_cache_clear_locked() {
		local state path
		local clear_failed=0
		[[ "${KION_AWS_CACHE_LOCKED:-}" == 1 ]] || return 1

		for state in cache pending legacy; do
			case "$state" in
			cache) path="$cache_root" ;;
			pending) path="$cache_parent/.$cache_name.pending" ;;
			legacy) path="$cache_parent/.$cache_name.legacy" ;;
			esac

			if [[ -e "$path" || -L "$path" ]]; then
				if ! rm -rf -- "$path"; then
					clear_failed=1
				fi
			fi
		done

		for path in "$cache_parent/$generation_prefix"*; do
			[[ -e "$path" || -L "$path" ]] || continue
			if ! _kion_aws_cache_remove_generation "$path"; then
				clear_failed=1
			fi
		done
		if ((clear_failed)); then
			echo "Cached AWS credentials could not be cleared." >&2
			return 1
		fi
	}

	_kion_aws_cache_clear() {
		local name
		if ! _kion_aws_cache_run_locked __clear_locked; then
			return 1
		fi

		for name in "${vars[@]}"; do
			unset "$name"
		done
	}

	_kion_aws_cache_ensure() {
		# 1. Current env creds are already valid — nothing to do.
		if _kion_aws_cache_validate_current 2>/dev/null; then
			return 0
		fi

		# 2. Cache files hold valid creds — load them.
		if _kion_aws_cache_load 2>/dev/null; then
			return 0
		fi

		# 3. Both stale — refresh the cache directly, then validate and load it.
		if ! command -v kion-aws-refresh >/dev/null 2>&1; then
			echo "kac ensure: credentials expired and kion-aws-refresh is not installed" >&2
			return 1
		fi
		if ! kion-aws-refresh; then
			echo "kac ensure: direct Kion credential refresh failed" >&2
			return 1
		fi
		_kion_aws_cache_load
	}

	_kion_aws_cache_status() {
		local current_state cache_state
		if _kion_aws_cache_validate_current; then
			current_state="valid"
		elif _kion_aws_cache_has_values; then
			current_state="set-but-invalid"
		else
			current_state="missing"
		fi

		if _kion_aws_cache_cache_has_values; then
			cache_state="present"
		else
			cache_state="missing"
		fi

		printf 'current=%s\ncache=%s\ncache_dir=%s\n' "$current_state" "$cache_state" "$cache_root"
	}

	_kion_aws_cache_require_sourced

	case "$command" in
	__clear_locked)
		_kion_aws_cache_clear_locked
		;;
	__dump_locked)
		_kion_aws_cache_dump_locked
		;;
	ensure)
		_kion_aws_cache_ensure
		;;
	dump)
		_kion_aws_cache_dump
		;;
	load)
		_kion_aws_cache_load
		;;
	clear)
		_kion_aws_cache_clear
		;;
	status)
		_kion_aws_cache_status
		;;
	help | -h | --help)
		_kion_aws_cache_usage
		;;
	*)
		echo "Unknown command: $command" >&2
		_kion_aws_cache_usage >&2
		return 1
		;;
	esac
}

if ! _kion_aws_cache_main "$@"; then
	unset -f _kion_aws_cache_main 2>/dev/null || true
	return 1
fi

unset -f _kion_aws_cache_main 2>/dev/null || true
