#!/usr/bin/env -S zsh -f
# Create (or reconnect) the rclone `gdrive:` remote that sync-to-gdrive needs.
#
# Fresh-machine bootstrap. sync-to-gdrive refuses to run without this remote,
# and its scheduled agent will fail daily until it exists — which is the
# intended alarm, not a bug. Run this once per new host.
#
# The OAuth *client* credentials are versioned encrypted at
# secrets/rclone-gdrive.json; the per-device *token* is deliberately not, so it
# never needs re-encrypting as it refreshes. See home-manager/modules/sops.nix.
#
# Credentials are read into shell variables and passed as arguments to rclone
# only within this process — they never reach shell history or an agent log.
#
# Requires a real terminal: rclone opens a browser to authorize the account.
emulate -R zsh
setopt err_exit no_unset pipe_fail

repo=${NIX_CONFIG_DIR-}
if [[ -z $repo ]]; then
	state_file=${XDG_STATE_HOME:-$HOME/.local/state}/chezmoi/nix-config-dir
	if [[ -f $state_file ]]; then
		repo=$(cat -- $state_file)
	else
		repo=$HOME/.config/nix
	fi
fi

secret=$repo/secrets/rclone-gdrive.json
remote_name=gdrive

for tool in rclone sops jq; do
	if ! (($+commands[$tool])); then
		print -ru2 -- "setup-gdrive-remote: $tool is not installed."
		print -ru2 -- '  It ships in the shared package set (home-manager/common.nix):'
		print -ru2 -- "  run 'task switch' (or 'task home-switch') to install it."
		exit 1
	fi
done

if [[ ! -f $secret ]]; then
	print -ru2 -- "setup-gdrive-remote: missing $secret"
	print -ru2 -- '  Set NIX_CONFIG_DIR to the repo checkout if it lives elsewhere.'
	exit 1
fi

age_key=${XDG_CONFIG_HOME:-$HOME/.config}/sops/age/keys.txt
if [[ ! -f $age_key ]]; then
	print -ru2 -- "setup-gdrive-remote: no age key at $age_key — cannot decrypt $secret."
	exit 1
fi
export SOPS_AGE_KEY_FILE=$age_key

if rclone listremotes 2>/dev/null | grep -qx "$remote_name:"; then
	print -r -- "==> remote '$remote_name:' exists; reconnecting its OAuth token"
	rclone config reconnect "$remote_name:"
else
	client_id=$(sops -d $secret | jq -r '.installed.client_id')
	client_secret=$(sops -d $secret | jq -r '.installed.client_secret')

	if [[ -z $client_id || $client_id == null || -z $client_secret || $client_secret == null ]]; then
		print -ru2 -- "setup-gdrive-remote: could not read client credentials from $secret"
		print -ru2 -- '  Expected shape: {"installed":{"client_id":…,"client_secret":…}}'
		exit 1
	fi

	print -r -- "==> creating remote '$remote_name:' (a browser will open to authorize)"
	rclone config create $remote_name drive scope=drive \
		client_id=$client_id client_secret=$client_secret

	unset client_id client_secret
fi

print
print -r -- '==> remotes now configured:'
rclone listremotes

print
print -r -- '==> verifying with a dry run (nothing is transferred):'
exec $HOME/.local/bin/sync-to-gdrive --dry-run
