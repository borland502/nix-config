#!/usr/bin/env python3
"""Capture a bounded CloudWatch Logs query to a private JSON file."""
import argparse
from datetime import datetime, timezone
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile


def timestamp(value):
    try:
        parsed = datetime.fromisoformat(value.replace("Z", "+00:00"))
        if parsed.tzinfo is None or parsed.utcoffset() is None:
            raise ValueError("timezone required")
        millis = int((parsed - datetime(1970, 1, 1, tzinfo=timezone.utc)).total_seconds() * 1000)
        if millis < 0:
            raise ValueError("time precedes Unix epoch")
        return millis
    except (ValueError, OverflowError) as exc:
        raise argparse.ArgumentTypeError("expected an ISO8601 time with timezone, at or after 1970") from exc


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("log_group")
    parser.add_argument("--start", required=True, type=timestamp)
    parser.add_argument("--end", required=True, type=timestamp)
    parser.add_argument("--output", required=True, type=Path)
    parser.add_argument("--region")
    parser.add_argument("--request-id")
    parser.add_argument("--force", action="store_true")
    args = parser.parse_args()
    if args.start >= args.end:
        parser.error("--start must precede --end")
    if not re.fullmatch(r"[.\-_/#A-Za-z0-9]{1,512}", args.log_group):
        parser.error("invalid log group name")
    if args.region is not None and not re.fullmatch(r"[a-z0-9-]+", args.region):
        parser.error("invalid region")
    if args.request_id is not None and not re.fullmatch(r"[A-Za-z0-9_-]+", args.request_id):
        parser.error("request ID must contain only letters, numbers, underscores or hyphens")
    target = args.output.expanduser().absolute()
    if os.path.lexists(target) and not args.force:
        parser.error("output already exists; use --force to replace it")
    if not target.parent.is_dir() or target.is_dir():
        parser.error("output must name a file in an existing directory")
    kac = os.environ.get("KAC_PATH", str(Path.home() / ".local/bin/kac"))
    aws = os.environ.get("AWS_BIN", "aws")
    command = [aws, "logs", "filter-log-events", "--log-group-name", args.log_group,
               "--start-time", str(args.start), "--end-time", str(args.end), "--output", "json"]
    if args.region:
        command.extend(["--region", args.region])
    if args.request_id:
        command.extend(["--filter-pattern", '"' + args.request_id + '"'])
    # Keep the shell program constant: all user input travels as argv. Sourcing
    # loads refreshed credentials into the same process that executes AWS.
    bridge = 'source "$1" ensure >&2 || exit 1; shift; exec "$@"'
    temporary = None
    try:
        with tempfile.NamedTemporaryFile(mode="w+b", dir=target.parent, prefix="." + target.name + ".", delete=False) as output:
            temporary = output.name
            env = dict(os.environ, AWS_PAGER="", AWS_CLI_AUTO_PROMPT="off")
            subprocess.run(["bash", "-c", bridge, "aws-log-fetch", kac, *command],
                           stdout=output, env=env, check=True)
            output.seek(0)
            payload = json.load(output)
            if not isinstance(payload, dict) or not isinstance(payload.get("events"), list):
                raise ValueError("AWS response must contain an events array")
            output.flush()
            os.fsync(output.fileno())
        if args.force:
            os.replace(temporary, target)
        else:
            # Atomic no-clobber publication, including concurrent writers.
            os.link(temporary, target)
            os.unlink(temporary)
        temporary = None
    except (OSError, ValueError, subprocess.CalledProcessError) as exc:
        print(f"aws-log-fetch: {exc}", file=sys.stderr)
        return 1
    finally:
        if temporary is not None:
            os.unlink(temporary)
    print(target)
    return 0


if __name__ == "__main__":
    sys.exit(main())
