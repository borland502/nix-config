#!/usr/bin/env zsh
# sync-to-gdrive — back up ~/.config and ~/.local to Google Drive via rclone.
#
# Replaces the earlier unison + mounted-drive (Library/CloudStorage) approach
# with the `gdrive:` rclone remote: network transfer, no mount required, so it
# runs on any host where the remote is configured.
#
# Design / efficiency (measured: a full recursive scan was 773k objects in
# ~459s, dominated by regenerable toolchain state under .local and the caches):
#   * --fast-list is the one flag that moved the needle — one recursive listing
#     instead of a request per directory. Other tuning flags did nothing.
#   * The real win is NOT scanning the regenerable bulk at all: .local/bin,
#     .local/share (Steam, fonts, docker rootless data, …), .local/src,
#     .local/pipx, .config/nix, and every cache are filtered out.
#
# What is skipped (omitted from upload):
#   * Secrets (sops/ops-agent/confluence/gkion/technitiumdns-cli/gh).
#   * Large regenerable dirs (nix, nvm, agent caches, .local/{bin,share,src,pipx}).
#   * Steam and docker config/data (.config/{steam,Steam,docker}; Steam & docker
#     rootless data already fall under .local/share).
#   * Transient artifacts (.cache, __pycache__, *.pyc, *.class, node_modules,
#     .git, thinking logs, OS cruft).
#   * Any single file larger than 1 GiB (--max-size, upload-skip only).
#
# Symlinks: nix/home-manager manages many .config entries (e.g. bat/config,
# starship.toml) as symlinks into /nix/store. rclone skips symlinks by default,
# so -L/--copy-links is used to back up the real content behind them — otherwise
# they would neither upload nor survive on the remote. Restored, they land as
# plain files; `task switch` re-symlinks them.
#
# Deletion policy:
#   * BACKUP (local -> gdrive) is ADDITIVE: rclone COPY, so a non-junk file is
#     only ever added or updated on the remote — never deleted just because it
#     is absent on this machine. That keeps the remote safe to share with other
#     hosts (e.g. darwin) and preserves history this host never had.
#   * Junk (transient/Steam/docker/regenerable/secret patterns) that was
#     previously backed up IS purged from the remote by a second rclone-delete
#     pass. Size-agnostic and remote-only.
#   * Oversize files are only skipped for upload — never deleted from the remote.
#   * Local deletion is an explicit, gated, UNSAFE action — see
#     --allow-local-delete. Without that flag nothing local is ever deleted.
#
# Scheduling: the backup direction runs daily and catches up after downtime —
# see home-manager/modules/gdrive-sync.nix (systemd timer on Linux, launchd
# agent on darwin).
#   Linux:  systemctl --user list-timers gdrive-sync.timer
#           journalctl --user -u gdrive-sync.service
#   darwin: launchctl list org.nix-community.home.gdrive-sync
#           ~/.cache/gdrive-sync.launchd.log
#
# Usage:
#   sync-to-gdrive [--dry-run] [--verbose] [--if-stale HOURS] [--allow-local-delete]
#
#   --dry-run             Show what would transfer/delete; change nothing.
#   --verbose             Add per-file rclone logging (-v) on top of --progress.
#   --if-stale HOURS      Backup direction only: exit 0 without doing anything
#                         unless the last successful backup is older than HOURS.
#                         Lets a scheduler fire opportunistically (e.g. launchd
#                         RunAtLoad, which is how darwin catches up on a run
#                         missed while the Mac was off) without re-syncing on
#                         every login. A successful, non-dry-run backup records
#                         its finish time in $stamp_file.
#   --allow-local-delete  UNSAFE. Switch to RESTORE (gdrive -> local): mirror
#                         the remote onto the LOCAL tree with rclone sync, which
#                         can DELETE local files absent from the remote. Requires
#                         typed confirmation unless --dry-run. The remote-purge
#                         pass is skipped in this direction, so local junk and
#                         secrets are never removed.

set -euo pipefail

# ── Configuration ─────────────────────────────────────────────────────────────
remote_name="gdrive"                 # rclone remote (see: rclone listremotes)
remote_base="${remote_name}:42245/dotfiles"
src_root="$HOME"
max_size="1G"                        # rclone units: 1G == 1 GiB
log_dir="$HOME/.cache/claude"
log_file="$log_dir/rclone-gdrive.log"
# Last-successful-backup marker for --if-stale. Deliberately NOT under
# ~/.cache/claude: compress-old-cache zstd-compresses (with --rm) every
# top-level file there older than a day, which would rename the stamp out from
# under us. Host-local by design — excluded from the sync below.
stamp_file="$HOME/.local/state/gdrive-sync/last-success"

usage() {
	print -r -- "Usage: sync-to-gdrive [--dry-run] [--verbose] [--if-stale HOURS] [--allow-local-delete]"
}

# ── Argument parsing ──────────────────────────────────────────────────────────
dry_run=0
verbose=0
allow_local_delete=0
if_stale=0
while (( $# )); do
	case "$1" in
	--dry-run) dry_run=1 ;;
	--verbose) verbose=1 ;;
	--allow-local-delete) allow_local_delete=1 ;;
	--if-stale)
		if [[ -z "${2:-}" || "$2" != <-> ]]; then
			print -u2 "sync-to-gdrive: --if-stale requires a whole number of hours"
			usage
			exit 2
		fi
		if_stale="$2"
		shift
		;;
	--if-stale=*)
		if_stale="${1#*=}"
		if [[ "$if_stale" != <-> ]]; then
			print -u2 "sync-to-gdrive: --if-stale requires a whole number of hours"
			usage
			exit 2
		fi
		;;
	-h | --help)
		usage
		exit 0
		;;
	*)
		print -u2 "sync-to-gdrive: unknown argument: $1"
		usage
		exit 2
		;;
	esac
	shift
done

# ── Staleness gate ────────────────────────────────────────────────────────────
# Checked before anything else: a scheduler-driven no-op should cost one stat,
# not the 20s remote-reachability probe below. Backup direction only — a restore
# is always an explicit, deliberate act and never consults the stamp.
if (( if_stale > 0 && ! allow_local_delete )); then
	if [[ -r "$stamp_file" ]]; then
		last_success="$(<"$stamp_file")"
		now="$(date +%s)"
		if [[ "$last_success" == <-> ]] && (( now - last_success < if_stale * 3600 )); then
			print "sync-to-gdrive: last successful backup $(( (now - last_success) / 60 ))m ago" \
				"(< ${if_stale}h) — nothing to do."
			exit 0
		fi
	fi
fi

# ── Dependency / artifact checks (warn or fail clearly, never silently) ───────
if ! command -v rclone >/dev/null 2>&1; then
	print -u2 "sync-to-gdrive: rclone not found."
	print -u2 "  It ships in the shared package set (home-manager/common.nix):"
	print -u2 "  run 'task switch' (or 'task home-switch') to install it."
	exit 1
fi

if ! rclone listremotes 2>/dev/null | grep -qx "${remote_name}:"; then
	print -u2 "sync-to-gdrive: rclone remote '${remote_name}:' is not configured."
	print -u2 "  Create it with:  rclone config   (type 'drive', name it '${remote_name}')."
	print -u2 "  The OAuth client creds are backed up encrypted at"
	print -u2 "  secrets/rclone-gdrive.json — see home-manager/modules/sops.nix for the"
	print -u2 "  fresh-machine 'rclone config reconnect ${remote_name}:' procedure."
	exit 1
fi

# Source directories present? (warn — an absent tree just contributes nothing.)
missing_src=()
for d in .config .local; do
	[[ -d "$src_root/$d" ]] || missing_src+=("$src_root/$d")
done
if (( ${#missing_src[@]} )); then
	print -u2 "sync-to-gdrive: WARNING missing source dir(s): ${missing_src[*]}"
fi

# Remote reachable / authorized? (soft — the sync itself would fail loudly too.)
if ! rclone lsd "${remote_name}:" --max-depth 1 --timeout 20s >/dev/null 2>&1; then
	print -u2 "sync-to-gdrive: WARNING cannot list '${remote_name}:' — remote may be"
	print -u2 "  offline or the token expired. Try: rclone config reconnect ${remote_name}:"
fi

mkdir -p "$log_dir"

# ── Junk patterns (skipped on upload AND purged from the remote) ──────────────
# One list drives two filters: excludes for the sync pass, includes for the
# remote purge pass. Paths are anchored to the transfer root ($HOME / dotfiles).
junk_patterns=(
	# ── Secrets — never leave the local machine ──
	'/.config/sops/**'
	'/.config/ops-agent/**'
	'/.config/confluence/**'
	'/.config/gkion/**'
	'/.config/technitiumdns-cli/**'
	'/.config/gh/**'
	# KeePass DB + keyfile are intentionally SYNCED for portability (carved back
	# in via keep_patterns below); only the yubikey serial is withheld. Even if
	# gdrive is breached the DB needs the yubikey (challenge-response) AND the
	# master password to open — neither is on the remote.
	'**/yubikey.serial'
	'/.config/keepassxc/**'        # secret_token, browser-integration secret
	'/.config/gcloud/**'           # credentials.db / access_tokens.db
	'/.config/1Password/**'        # 1password.sqlite + local vault cache
	'/.config/aws/**'              # aws credentials / config
	# Browser/Electron session token stores (cookies, tokens, IndexedDB).
	'**/Cookies'
	'**/Cookies-journal'
	'**/Local Storage/**'
	'**/Session Storage/**'
	'**/IndexedDB/**'
	# ── Large / regenerable state (nix-managed, git, or reinstallable) ──
	'/.config/nix/**'
	'/.config/nix.worktrees/**'
	'/.config/unison/**'
	'/.config/github-copilot/**'
	'/.config/claude/**'
	'/.config/nvm/**'
	'/.local/bin/**'
	'/.local/share/**'
	'/.local/src/**'
	'/.local/pipx/**'
	'/.local/state/nix/**'            # nix profiles: symlinks into /nix/store
	'/.local/state/home-manager/**'   # HM generations: symlinks into /nix/store
	'/.local/state/gdrive-sync/**'    # this script's own --if-stale stamp (host-local)
	'/.cache/**'
	# Duplicate config trees (bootstrap cruft mirroring ~/.config).
	'/.config/.config/**'
	'/.local/.config/**'
	# ── Steam & docker (data under .local/share is already covered above) ──
	'/.config/steam/**'
	'/.config/Steam/**'
	'/.config/docker/**'
	# ── KDE / desktop state that differs per host and is meaningless on macOS:
	#    shortcuts, menus, panel & window layout, session UI state, autostart ──
	'/.config/kglobalshortcutsrc'
	'/.config/khotkeysrc'
	'/.config/khotkeys/**'
	'/.config/kwinrc'
	'/.config/kwinrulesrc'
	'/.config/kmenueditrc'
	'/.config/menus/**'
	'/.config/plasma-org.kde.plasma.desktop-appletsrc'
	'/.config/plasmashellrc'
	'/.config/plasmarc'
	'/.config/plasma-localerc'
	'/.config/powerdevilrc'
	'/.config/powermanagementprofilesrc'
	'/.config/kscreenlockerrc'
	'/.config/kactivitymanagerdrc'
	'/.config/ksmserverrc'
	'/.config/kded5rc'
	'/.config/kded6rc'
	'/.config/kdedefaults/**'
	'/.config/autostart/**'
	'/.local/state/UserFeedback.org.kde.*'
	'**/*staterc'   # KDE UI *staterc files (dolphin, kate, konsole, plasma, …)
	# ── Browser/Electron caches (transient, large, regenerable) ──
	'**/[Cc]ache/**'         # Cache, cache (Chromium, Firefox, Shared Dictionary)
	'**/[Cc]ache2/**'        # Firefox disk cache
	'**/Cached*/**'          # VS Code CachedData/Extensions/Configurations/…
	'**/CacheStorage/**'     # Service Worker + WebStorage CacheStorage
	'**/Code Cache/**'
	'**/GPUCache/**'
	'**/ShaderCache/**'
	'**/GrShaderCache/**'
	'**/DawnCache/**'
	'**/DawnGraphiteCache/**'
	'**/DawnWebGPUCache/**'
	'**/GraphiteDawnCache/**'
	'**/blob_storage/**'
	'**/Crashpad/**'
	'**/Crash Reports/**'
	'**/component_crx_cache/**'
	# ── Transient artifacts by name, at any depth ──
	'**/__pycache__/**'
	'*.pyc'
	'*.class'
	'**/node_modules/**'
	'**/.git/**'
	'.gitignore'
	'*.thinking.log'
	'.thinking-cursor'
	'*.bak-*'          # home-manager activation backups (*.bak-20260728-105533)
	'**/*.pre-hm-*/**' # home-manager pre-activation backup dirs
	# Electron/Chromium runtime lock symlinks — usually dangling, so -L errors.
	'SingletonLock'
	'SingletonCookie'
	'SingletonSocket'
	'.DS_Store'
	'.localized'
	'Thumbs.db'
	'.tmp.driveupload'
	'*.log'
)

# Force-synced exceptions: kept even though a broader junk rule (the blanket
# /.local/share exclude) would otherwise drop them. Encrypted KeePass databases
# live under .local/share; carve them back in for portability. Targeting the
# specific dirs (not **/*.kdbx) keeps the scan from descending the rest of
# .local/share.
keep_patterns=(
	'/.local/share/keepassxc/**'
	'/.local/share/keypass/**'
)

# Filters are first-match-wins. sync_filter: keep_patterns win (+) over the junk
# excludes (-), then only the two dotfile trees are included and all else at
# $HOME dropped. purge_filter is the inverse — keep_patterns are protected (-)
# from deletion, junk is included (+) so `rclone delete` removes exactly those.
sync_filter="$(mktemp -t rclone-gdrive-sync.XXXXXX)"
purge_filter="$(mktemp -t rclone-gdrive-purge.XXXXXX)"
trap 'rm -f "$sync_filter" "$purge_filter"' EXIT
for p in "${keep_patterns[@]}"; do
	print -r -- "+ $p" >>"$sync_filter"
	print -r -- "- $p" >>"$purge_filter"
done
for p in "${junk_patterns[@]}"; do
	print -r -- "- $p" >>"$sync_filter"
	print -r -- "+ $p" >>"$purge_filter"
done
{
	print -r -- "+ /.config/**"
	print -r -- "+ /.local/**"
	print -r -- "- *"
} >>"$sync_filter"
print -r -- "- *" >>"$purge_filter"

# ── Shared rclone args ────────────────────────────────────────────────────────
# --progress gives the live per-file progress display, but only makes sense on a
# terminal: it repaints continuously, so under the systemd timer (see
# home-manager/modules/gdrive-sync.nix) it would flood the journal. Non-tty runs
# get one summary line every 5 minutes instead.
base_args=(--fast-list --log-file "$log_file" --log-level INFO)
if [[ -t 1 ]]; then
	base_args+=(--progress)
else
	base_args+=(--stats 5m --stats-one-line)
fi
(( verbose )) && base_args+=(--verbose)
(( dry_run )) && base_args+=(--dry-run)

if (( allow_local_delete )); then
	mode="RESTORE (gdrive -> local)"
	sync_src="$remote_base"
	sync_dst="$src_root"
else
	mode="BACKUP (local -> gdrive)"
	sync_src="$src_root"
	sync_dst="$remote_base"
fi

print "sync-to-gdrive: ${mode}$( (( dry_run )) && print -n '  [dry-run]' )"
print "  from: $sync_src"
print "  to:   $sync_dst"
print "  log:  $log_file"

# ── Confirmation gate for the unsafe direction ────────────────────────────────
if (( allow_local_delete && ! dry_run )); then
	print -u2 ""
	print -u2 "  !!! RESTORE can DELETE local files under ~/.config and ~/.local that are"
	print -u2 "      not present on the remote. Re-run with --dry-run first to preview."
	print -n  "  Type 'yes' to proceed: "
	read -r reply
	if [[ "$reply" != "yes" ]]; then
		print "sync-to-gdrive: aborted."
		exit 130
	fi
fi

# ── Run ───────────────────────────────────────────────────────────────────────
print "sync-to-gdrive: starting at $(date -Iseconds)"

# -L backs up the real content behind nix/home-manager symlinks. --max-size only
# skips oversize UPLOADS — it is kept out of every delete path so a >1 GiB file
# is never removed from the backup.
xfer_args=(-L --filter-from "$sync_filter" --max-size "$max_size" "${base_args[@]}")

if (( allow_local_delete )); then
	# RESTORE (unsafe): mirror the remote down onto local; rclone sync may DELETE
	# local files that are absent from the remote. No purge pass — never delete
	# on the local side beyond this gated mirror.
	rclone sync "$sync_src" "$sync_dst" "${xfer_args[@]}"
else
	# Pass 1 — BACKUP, additive: rclone copy never deletes a non-junk file on the
	# remote, so a file missing from this host (or pushed by another machine) is
	# preserved. Adds/updates only.
	rclone copy "$sync_src" "$sync_dst" "${xfer_args[@]}"

	# Pass 2 — purge junk from the remote (remote-only; size-agnostic). This is
	# the only place a backup run deletes anything, and only ever on gdrive.
	print "sync-to-gdrive: purging junk patterns from remote"
	rclone delete "$remote_base" --filter-from "$purge_filter" "${base_args[@]}"

	# Record success for --if-stale. Only here: `set -e` means we never reach
	# this line if either pass failed, so a failed run stays "stale" and the
	# next opportunistic trigger retries it. A dry-run transferred nothing and
	# must not suppress the real one.
	if (( ! dry_run )); then
		mkdir -p "${stamp_file:h}"
		print -r -- "$(date +%s)" >"$stamp_file"
	fi
fi

print "sync-to-gdrive: done at $(date -Iseconds)"
