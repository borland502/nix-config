#!/usr/bin/env bash
# Best-effort pre-change btrfs snapshot of the snapper `root` config.
#
# Usage: btrfs-safety-snapshot [description] [task-tag]
#   description  snapper --description text (default: "pre change <timestamp>")
#   task-tag     snapper --userdata task=<tag> value (default: "manual")
#   SKIP_SNAPSHOT=1  bypass entirely
#
# No-op unless snapper's `root` config exists, so it silently skips on macOS,
# WSL, and non-snapper Linux. It also skips when running non-interactively
# without usable root (CI, agent shells) so a sudo password prompt can't abort
# an otherwise-headless caller. When snapper IS present and root is reachable
# it is fail-closed: a genuine snapshot failure exits non-zero rather than
# proceeding unprotected.
#
# Standalone use: run before any risky manual change (editing system configs
# by hand, a package upgrade outside nix) to get the same grub-btrfs
# boot-into-snapshot safety net that `task switch` gets automatically.
set -euo pipefail

desc="${1:-pre change $(date +%FT%T)}"
task_tag="${2:-manual}"

if [[ "${SKIP_SNAPSHOT:-}" == "1" ]]; then
  echo "snapshot: skipped (SKIP_SNAPSHOT=1)"
  exit 0
fi

command -v snapper >/dev/null 2>&1 || exit 0
[[ -f /etc/snapper/configs/root ]] || exit 0

if [[ "$(uname)" == "Linux" && -x /run/wrappers/bin/sudo ]]; then
  root_cmd=/run/wrappers/bin/sudo
else
  root_cmd=sudo
fi

if ! "$root_cmd" -n true 2>/dev/null && [[ ! -t 0 ]]; then
  echo "snapshot: skipped (non-interactive shell; no cached sudo credentials)" >&2
  exit 0
fi

echo "snapshot: creating pre-change btrfs snapshot (may prompt for sudo)..."
if "$root_cmd" snapper -c root create \
  --description "$desc" \
  --cleanup-algorithm number \
  --userdata "task=$task_tag"; then
  echo "snapshot: created root snapshot: $desc"
else
  echo "snapshot: ERROR snapper create failed; aborting (bypass with SKIP_SNAPSHOT=1)" >&2
  exit 1
fi
