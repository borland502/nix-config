#!/usr/bin/env -S zsh -f
# Make sure the login shell is home-manager's zsh, tolerating environments
# where root can't be reached non-interactively (CI, agent shells, `!`
# prefixed commands).
#
# Standalone use: after any operation that (re)installs zsh into the nix
# profile, e.g. `ensure-nix-zsh-shell`. Also called by `task home-switch` /
# `task upgrade` on plain (non-NixOS) Linux, where the login shell is not
# managed by users.defaultUserShell.
emulate -R zsh
setopt err_exit no_unset pipe_fail

zsh_path=${1:-$HOME/.nix-profile/bin/zsh}

if [[ ! -x $zsh_path ]]; then
	print -ru2 -- "ensure-nix-zsh-shell: no executable zsh at $zsh_path; nothing to do"
	exit 0
fi

# A user missing from /etc/passwd (macOS, LDAP/SSSD accounts) has no entry to
# read; treat that as "not zsh yet" instead of failing the pipeline.
current_shell=$(grep -m1 "^$USER:" /etc/passwd | cut -d: -f7 || true)
if [[ $current_shell == $zsh_path ]]; then
	exit 0
fi

# Changing the login shell needs root. Only attempt it when sudo can elevate
# without a prompt or there is a TTY to prompt on — otherwise a non-interactive
# run (CI, agent shells) would abort here even though the caller's real work
# already succeeded.
if sudo -n true 2>/dev/null || [[ -t 0 ]]; then
	grep -qxF $zsh_path /etc/shells 2>/dev/null || print -r -- $zsh_path | sudo tee -a /etc/shells >/dev/null
	sudo usermod -s $zsh_path $USER || chsh -s $zsh_path || printf 'Note: run: sudo usermod -s %s %s\n' $zsh_path $USER
else
	printf 'Note: login shell left unchanged (non-interactive; no sudo). Run: sudo usermod -s %s %s\n' $zsh_path $USER
fi
