#!/usr/bin/env -S zsh -f
# Compact, read-only CloudFormation stack failure triage.
# The JMESPath queries use literal backticks, not command substitution.
emulate -R zsh
setopt err_exit no_unset pipe_fail

usage() {
	print -r -- 'Usage: aws-stack-triage STACK [--region REGION] [--summary] [--nested] [--failures] [--resources] [--all]'
}

(($#)) || {
	usage >&2
	exit 64
}
stack=$1
shift
region=""
summary=0 nested=0 failures=0 resources=0 selected=0
while (($#)); do
	case $1 in
	--region)
		shift
		region="${1:?--region needs a value}"
		;;
	--summary) summary=1 selected=1 ;;
	--nested) nested=1 selected=1 ;;
	--failures) failures=1 selected=1 ;;
	--resources) resources=1 selected=1 ;;
	--all) summary=1 nested=1 failures=1 resources=1 selected=1 ;;
	-h | --help)
		usage
		exit 0
		;;
	*)
		print -ru2 -- "aws-stack-triage: unknown argument: $1"
		exit 64
		;;
	esac
	shift
done
if ((selected == 0)); then
	summary=1 nested=1 failures=1
fi

kac_path=${KAC_PATH:-$HOME/.local/bin/kac}
[[ -f $kac_path ]] || {
	print -ru2 -- "aws-stack-triage: kac not found: $kac_path"
	exit 1
}
source $kac_path ensure
aws_bin=${AWS_BIN:-aws}
aws_args=()
[[ -n $region ]] && aws_args+=(--region $region)
failed_events='StackEvents[?contains(ResourceStatus, `FAILED`) || contains(ResourceStatus, `ROLLBACK`)].[Timestamp,LogicalResourceId,ResourceStatus,ResourceStatusReason]'

if ((summary)); then
	print 'SUMMARY'
	$aws_bin cloudformation describe-stacks --stack-name $stack $aws_args \
		--query 'Stacks[0].[StackName,StackStatus,StackStatusReason]' --output text
fi
child_stacks=()
if ((nested || resources)); then
	((summary)) && print
	if ((resources)); then
		print 'RESOURCES'
		resource_query='StackResourceSummaries[].[LogicalResourceId,ResourceType,PhysicalResourceId,ResourceStatus]'
	else
		print 'NESTED STACKS'
		resource_query='StackResourceSummaries[?ResourceType==`AWS::CloudFormation::Stack`].[LogicalResourceId,ResourceType,PhysicalResourceId,ResourceStatus]'
	fi
	resource_output=$($aws_bin cloudformation list-stack-resources --stack-name $stack $aws_args \
		--query $resource_query --output text)
	print -r -- $resource_output
	# Quoted (f): one element per line, and none for empty output.
	child_stacks=(${(f)"$(print -r -- $resource_output | awk '$2 == "AWS::CloudFormation::Stack" { print $3 }')"})
fi
if ((failures)); then
	((summary || nested || resources)) && print
	print 'FAILED EVENTS'
	$aws_bin cloudformation describe-stack-events --stack-name $stack $aws_args \
		--query $failed_events --output text
	for child_stack in $child_stacks; do
		printf '\nCHILD FAILED EVENTS: %s\n' $child_stack
		$aws_bin cloudformation describe-stack-events --stack-name $child_stack $aws_args \
			--query $failed_events --output text
	done
fi
