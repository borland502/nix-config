#!/usr/bin/env python3
"""Wait for a GitHub Actions run or named job; passive unless explicitly requested."""
import argparse
import json
import subprocess
import sys
import time


class Parser(argparse.ArgumentParser):
    def error(self, message):
        self.print_usage(sys.stderr)
        self.exit(64, f"{self.prog}: {message}\n")


def seconds(value):
    if not value.isdecimal():
        raise argparse.ArgumentTypeError("must be a nonnegative integer")
    return int(value)


def main():
    parser = Parser(description=__doc__)
    parser.add_argument("run", type=seconds)
    parser.add_argument("--job", help="exact job name; omit to wait for the entire run")
    parser.add_argument("--repo", help="OWNER/REPO (otherwise gh's current repository)")
    parser.add_argument("--timeout", type=seconds, default=2400)
    parser.add_argument("--interval", type=seconds, default=20)
    parser.add_argument("--cancel-duplicates", action="store_true",
                        help="cancel older runs of this workflow/branch and follow the newest")
    args = parser.parse_args()
    if not args.run or args.interval == 0 or args.job == "":
        parser.error("run and interval must be positive; job must not be empty")
    repo = ["--repo", args.repo] if args.repo else []
    deadline = time.monotonic() + args.timeout

    def gh(*command):
        result = subprocess.run(["gh", *command, *repo], capture_output=True, text=True,
                                timeout=max(1, min(60, deadline - time.monotonic())))
        if result.returncode:
            raise RuntimeError(f"gh {' '.join(command[:2])} failed: {result.stderr.strip()}")
        # Mutation commands can print prose. Read commands must return JSON.
        return None if command[:2] == ("run", "cancel") else json.loads(result.stdout)

    previous = None
    try:
        while True:
            snapshot = gh("run", "view", str(args.run), "--json",
                          "status,conclusion,jobs,headBranch,workflowName")
            if not isinstance(snapshot, dict) or not isinstance(snapshot.get("jobs"), list):
                raise RuntimeError("gh returned an invalid run snapshot")
            if args.cancel_duplicates and snapshot["status"] != "completed":
                branch, workflow = snapshot.get("headBranch"), snapshot.get("workflowName")
                if not branch or not workflow:
                    raise RuntimeError("cannot identify workflow and branch for duplicate cancellation")
                runs = gh("run", "list", "--branch", branch, "--workflow", workflow,
                          "--limit", "100", "--json", "databaseId,status")
                active = [r["databaseId"] for r in runs if r["status"] != "completed"]
                newest = max([args.run, *active])
                for run in sorted(set(active + [args.run])):
                    if run < newest:
                        gh("run", "cancel", str(run))
                        print(f"Cancelled older run {run}", flush=True)
                if newest != args.run:
                    args.run, previous = newest, None
                    if time.monotonic() >= deadline:
                        return 124
                    continue
            jobs = [j for j in snapshot["jobs"] if not args.job or j.get("name") == args.job]
            state = [(j.get("name"), j.get("status"), j.get("conclusion")) for j in jobs]
            signature = (snapshot["status"], snapshot.get("conclusion"), state)
            if signature != previous:
                print(f"Run {args.run}: {snapshot['status']} {snapshot.get('conclusion') or ''}", flush=True)
                for name, status, conclusion in state:
                    print(f"  {name}: {status} {conclusion or ''}", flush=True)
                previous = signature
            if args.job:
                if jobs and all(j.get("status") == "completed" for j in jobs):
                    return 0 if all(j.get("conclusion") == "success" for j in jobs) else 1
                if snapshot["status"] == "completed":
                    print(f"Job {args.job!r} not found or incomplete in completed run {args.run}", file=sys.stderr)
                    return 1
            else:
                if any(j.get("conclusion") in ("failure", "timed_out", "cancelled") for j in jobs):
                    return 1
                if snapshot["status"] == "completed":
                    return 0 if snapshot.get("conclusion") == "success" else 1
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                print(f"Timed out waiting for run {args.run}", file=sys.stderr)
                return 124
            time.sleep(min(args.interval, remaining))
    except subprocess.TimeoutExpired:
        print("Timed out fetching GitHub run status", file=sys.stderr)
        return 124
    except (OSError, ValueError, KeyError, TypeError, RuntimeError) as error:
        print(f"gh-wait-job: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
