#!/usr/bin/env bash
# Passive by default. --job waits for one job; --cancel-duplicates opts into mutation.
set -euo pipefail
bin_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
waiter="$bin_dir/gh-wait-job"
# Support direct execution from the chezmoi source tree, too.
if [[ ! -x "$waiter" ]]; then waiter="$bin_dir/executable_gh-wait-job"; fi
exec "$waiter" "$@"
