{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "command": "\"$HOME/.local/bin/ai-tools/agent-cache-capture\" --agent copilot --event sessionStart || :",
        "timeoutSec": 3
      }
    ],
    "sessionEnd": [
      {
        "type": "command",
        "command": "\"$HOME/.local/bin/ai-tools/agent-cache-capture\" --agent copilot --event sessionEnd || :",
        "timeoutSec": 3
      }
    ],
    "userPromptSubmitted": [
      {
        "type": "command",
        "command": "\"$HOME/.local/bin/ai-tools/agent-cache-capture\" --agent copilot --event userPromptSubmitted || :",
        "timeoutSec": 3
      }
    ],
